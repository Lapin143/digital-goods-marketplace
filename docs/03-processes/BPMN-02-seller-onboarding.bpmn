<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_app" name="Заявитель" processRef="Process_applicant" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_mail" name="E-mail-провайдер" />
    <bpmn:messageFlow id="Msg_a_send_s_app" name="Заявка с анкетой и документами" sourceRef="a_send" targetRef="s_app" />
    <bpmn:messageFlow id="Msg_t_mail_P_mail" name="Письмо с решением" sourceRef="t_mail" targetRef="P_mail" />
    <bpmn:messageFlow id="Msg_P_mail_a_wait" name="Письмо в почтовом ящике" sourceRef="P_mail" targetRef="a_wait" />
    <bpmn:messageFlow id="Msg_a_2fa_s_2fa" name="Код из приложения-аутентификатора" sourceRef="a_2fa" targetRef="s_2fa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_applicant" isExecutable="false">
    <bpmn:startEvent id="a_start" name="Пользователь решил стать продавцом">
      <bpmn:outgoing>Flow_a_start_a_fill</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_fill" name="Заполнить анкету и загрузить документы">
      <bpmn:documentation>FT-2.0: анкета, тип (ИП, самозанятый, юрлицо), документы, описание ассортимента. SM-05: профиль в статусе «черновик».</bpmn:documentation>
      <bpmn:incoming>Flow_a_start_a_fill</bpmn:incoming>
      <bpmn:incoming>Flow_lc_new_a_fill</bpmn:incoming>
      <bpmn:outgoing>Flow_a_fill_a_send</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_send" name="Отправить заявку на проверку">
      <bpmn:documentation>SM-05: черновик (или на доработке) -&gt; на проверке.</bpmn:documentation>
      <bpmn:incoming>Flow_a_fill_a_send</bpmn:incoming>
      <bpmn:incoming>Flow_a_rework_a_send</bpmn:incoming>
      <bpmn:outgoing>Flow_a_send_a_wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="a_wait" name="Письмо с решением получено">
      <bpmn:incoming>Flow_a_send_a_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_a_wait_a_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_wait_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_gw" name="Какое решение?">
      <bpmn:incoming>Flow_a_wait_a_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_a_gw_a_2fa</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_gw_a_rework</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_gw_a_new</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_rework" name="Доработать заявку по комментарию">
      <bpmn:documentation>Заявитель исправляет замечания модератора и подаёт заявку повторно.</bpmn:documentation>
      <bpmn:incoming>Flow_a_gw_a_rework</bpmn:incoming>
      <bpmn:outgoing>Flow_a_rework_a_send</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_2fa" name="Войти и настроить 2FA">
      <bpmn:documentation>FT-1.3, NFT-3.0: для продавца вторая ступень входа обязательна.</bpmn:documentation>
      <bpmn:incoming>Flow_a_gw_a_2fa</bpmn:incoming>
      <bpmn:outgoing>Flow_a_2fa_a_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="a_end" name="Кабинет продавца открыт">
      <bpmn:incoming>Flow_a_2fa_a_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="a_new" name="Исправить анкету и подать новую заявку">
      <bpmn:documentation>FT-2.4: после отказа можно подать новую заявку не раньше чем через 24 часа. SM-05: отклонён -&gt; черновик.</bpmn:documentation>
      <bpmn:incoming>Flow_a_gw_a_new</bpmn:incoming>
      <bpmn:outgoing>Flow_a_new_lt_new</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="lt_new" name="Новая заявка">
      <bpmn:incoming>Flow_a_new_lt_new</bpmn:incoming>
      <bpmn:linkEventDefinition id="lt_new_def" name="Новая заявка" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="lc_new" name="Новая заявка">
      <bpmn:outgoing>Flow_lc_new_a_fill</bpmn:outgoing>
      <bpmn:linkEventDefinition id="lc_new_def" name="Новая заявка" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_a_start_a_fill" sourceRef="a_start" targetRef="a_fill" />
    <bpmn:sequenceFlow id="Flow_a_fill_a_send" sourceRef="a_fill" targetRef="a_send" />
    <bpmn:sequenceFlow id="Flow_a_send_a_wait" sourceRef="a_send" targetRef="a_wait" />
    <bpmn:sequenceFlow id="Flow_a_wait_a_gw" sourceRef="a_wait" targetRef="a_gw" />
    <bpmn:sequenceFlow id="Flow_a_gw_a_2fa" name="одобрено" sourceRef="a_gw" targetRef="a_2fa" />
    <bpmn:sequenceFlow id="Flow_a_gw_a_rework" name="на доработку" sourceRef="a_gw" targetRef="a_rework" />
    <bpmn:sequenceFlow id="Flow_a_rework_a_send" sourceRef="a_rework" targetRef="a_send" />
    <bpmn:sequenceFlow id="Flow_a_2fa_a_end" sourceRef="a_2fa" targetRef="a_end" />
    <bpmn:sequenceFlow id="Flow_a_gw_a_new" name="отклонено" sourceRef="a_gw" targetRef="a_new" />
    <bpmn:sequenceFlow id="Flow_a_new_lt_new" sourceRef="a_new" targetRef="lt_new" />
    <bpmn:sequenceFlow id="Flow_lc_new_a_fill" sourceRef="lc_new" targetRef="a_fill" />
    <bpmn:textAnnotation id="Note_3d"><bpmn:text>Срок рассмотрения не более 3 суток (FT-2.1). Он считается заново с каждой подачи, в том числе после доработки</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_3d" sourceRef="Note_3d" targetRef="a_send" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_moderator" name="Модератор">
        <bpmn:flowNodeRef>u_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_3d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_alert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sellers" name="Подключение продавцов">
        <bpmn:flowNodeRef>s_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cool</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cool</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cool</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_identity" name="Идентификация">
        <bpmn:flowNodeRef>t_role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_2fa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_2fa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_2fa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_notify" name="Уведомления">
        <bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_notified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_app" name="Заявка подана">
      <bpmn:outgoing>Flow_s_app_g_cool</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_app_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_save" name="Сохранить документы, профиль «на проверке»">
      <bpmn:documentation>SM-05: -&gt; на проверке. Документы лежат в S3-совместимом хранилище в РФ.</bpmn:documentation>
      <bpmn:incoming>Flow_g_cool_t_save</bpmn:incoming>
      <bpmn:outgoing>Flow_t_save_t_queue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_queue" name="Поставить заявку в очередь модератора">
      <bpmn:documentation>Срок рассмотрения не более 3 суток отсчитывается с момента подачи.</bpmn:documentation>
      <bpmn:incoming>Flow_t_save_t_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_t_queue_u_review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dec" name="Решение
модератора">
      <bpmn:incoming>Flow_u_review_g_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_g_dec_t_reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_dec_t_rework</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_dec_t_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_reject" name="Профиль «отклонён», сохранить причину">
      <bpmn:documentation>SM-05: на проверке -&gt; отклонён. Причина обязательна (FT-2.1).</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_t_reject_j_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_rework" name="Профиль «на доработке», сохранить комментарий">
      <bpmn:documentation>SM-05: на проверке -&gt; на доработке.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_rework</bpmn:incoming>
      <bpmn:outgoing>Flow_t_rework_j_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_approve" name="Профиль «одобрен»">
      <bpmn:documentation>SM-05: на проверке -&gt; одобрен.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_t_approve_t_role</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_dec">
      <bpmn:incoming>Flow_t_reject_j_dec</bpmn:incoming>
      <bpmn:incoming>Flow_t_rework_j_dec</bpmn:incoming>
      <bpmn:incoming>Flow_t_role_j_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_j_dec_t_audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_audit" name="Записать решение в журнал аудита">
      <bpmn:documentation>FT-11.2: действие модератора фиксируется в неизменяемом журнале. Персональные данные в журнал не попадают (NFT-5.3).</bpmn:documentation>
      <bpmn:incoming>Flow_j_dec_t_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_audit_t_mail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u_review" name="Принять решение по заявке">
      <bpmn:documentation>FT-2.1: одобрить, отклонить с указанием причины, вернуть на доработку. Срок не более 3 суток.</bpmn:documentation>
      <bpmn:incoming>Flow_t_queue_u_review</bpmn:incoming>
      <bpmn:outgoing>Flow_u_review_g_dec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_3d" attachedToRef="u_review" cancelActivity="false">
      <bpmn:outgoing>Flow_b_3d_e_alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="b_3d_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_alert" name="Администратор оповещён о просрочке">
      <bpmn:documentation>NFT-6.1: метрика сроков модерации и оповещение. Заявка остаётся в очереди.</bpmn:documentation>
      <bpmn:incoming>Flow_b_3d_e_alert</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_alert_def" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_role" name="Назначить роль «Продавец», потребовать 2FA">
      <bpmn:documentation>Роль в Keycloak. При первом входе продавец обязан настроить второй фактор.</bpmn:documentation>
      <bpmn:incoming>Flow_t_approve_t_role</bpmn:incoming>
      <bpmn:outgoing>Flow_t_role_j_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s_2fa" name="Настройка 2FA при первом входе">
      <bpmn:outgoing>Flow_s_2fa_t_2fa</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_2fa_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_2fa" name="Проверить код и включить 2FA">
      <bpmn:documentation>FT-1.3, NFT-3.0.</bpmn:documentation>
      <bpmn:incoming>Flow_s_2fa_t_2fa</bpmn:incoming>
      <bpmn:outgoing>Flow_t_2fa_e_2fa</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_2fa" name="Продавец подключён">
      <bpmn:incoming>Flow_t_2fa_e_2fa</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_mail" name="Отправить письмо с решением и причиной">
      <bpmn:documentation>FT-2.2: решение, причина отказа или комментарий для доработки.</bpmn:documentation>
      <bpmn:incoming>Flow_t_audit_t_mail</bpmn:incoming>
      <bpmn:outgoing>Flow_t_mail_e_notified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_notified" name="Заявитель уведомлён">
      <bpmn:incoming>Flow_t_mail_e_notified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_cool" name="Подача после отказа раньше чем через 24 часа?">
      <bpmn:incoming>Flow_s_app_g_cool</bpmn:incoming>
      <bpmn:outgoing>Flow_g_cool_t_save</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_cool_t_cool</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_cool" name="Не принять заявку: новая подача возможна через 24 часа">
      <bpmn:documentation>FT-2.4: ограничение защищает очередь модератора от повторов. Значение 24 часа, параметр платформы (FT-11.1).</bpmn:documentation>
      <bpmn:incoming>Flow_g_cool_t_cool</bpmn:incoming>
      <bpmn:outgoing>Flow_t_cool_e_cool</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_cool" name="Заявка не принята">
      <bpmn:incoming>Flow_t_cool_e_cool</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_t_save_t_queue" sourceRef="t_save" targetRef="t_queue" />
    <bpmn:sequenceFlow id="Flow_t_queue_u_review" sourceRef="t_queue" targetRef="u_review" />
    <bpmn:sequenceFlow id="Flow_u_review_g_dec" sourceRef="u_review" targetRef="g_dec" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_reject" name="отклонить с причиной" sourceRef="g_dec" targetRef="t_reject" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_rework" name="вернуть на доработку" sourceRef="g_dec" targetRef="t_rework" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_approve" name="одобрить" sourceRef="g_dec" targetRef="t_approve" />
    <bpmn:sequenceFlow id="Flow_t_reject_j_dec" sourceRef="t_reject" targetRef="j_dec" />
    <bpmn:sequenceFlow id="Flow_t_rework_j_dec" sourceRef="t_rework" targetRef="j_dec" />
    <bpmn:sequenceFlow id="Flow_t_approve_t_role" sourceRef="t_approve" targetRef="t_role" />
    <bpmn:sequenceFlow id="Flow_t_role_j_dec" sourceRef="t_role" targetRef="j_dec" />
    <bpmn:sequenceFlow id="Flow_j_dec_t_audit" sourceRef="j_dec" targetRef="t_audit" />
    <bpmn:sequenceFlow id="Flow_t_audit_t_mail" sourceRef="t_audit" targetRef="t_mail" />
    <bpmn:sequenceFlow id="Flow_t_mail_e_notified" sourceRef="t_mail" targetRef="e_notified" />
    <bpmn:sequenceFlow id="Flow_b_3d_e_alert" sourceRef="b_3d" targetRef="e_alert" />
    <bpmn:sequenceFlow id="Flow_s_2fa_t_2fa" sourceRef="s_2fa" targetRef="t_2fa" />
    <bpmn:sequenceFlow id="Flow_t_2fa_e_2fa" sourceRef="t_2fa" targetRef="e_2fa" />
    <bpmn:sequenceFlow id="Flow_s_app_g_cool" sourceRef="s_app" targetRef="g_cool" />
    <bpmn:sequenceFlow id="Flow_g_cool_t_save" name="нет" sourceRef="g_cool" targetRef="t_save" />
    <bpmn:sequenceFlow id="Flow_g_cool_t_cool" name="да" sourceRef="g_cool" targetRef="t_cool" />
    <bpmn:sequenceFlow id="Flow_t_cool_e_cool" sourceRef="t_cool" targetRef="e_cool" />
    <bpmn:textAnnotation id="Note_late"><bpmn:text>Что делать при просрочке, требования не определяют. Принято: оповещение и метрика (NFT-6.1), заявка остаётся в очереди</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_late" sourceRef="Note_late" targetRef="e_alert" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="P_app_di" bpmnElement="P_app" isHorizontal="true"><dc:Bounds x="40" y="20" width="2400" height="290" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_platform_di" bpmnElement="P_platform" isHorizontal="true"><dc:Bounds x="40" y="370" width="2400" height="810" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_moderator_di" bpmnElement="Lane_moderator" isHorizontal="true"><dc:Bounds x="70" y="370" width="2370" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sellers_di" bpmnElement="Lane_sellers" isHorizontal="true"><dc:Bounds x="70" y="580" width="2370" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_identity_di" bpmnElement="Lane_identity" isHorizontal="true"><dc:Bounds x="70" y="920" width="2370" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_notify_di" bpmnElement="Lane_notify" isHorizontal="true"><dc:Bounds x="70" y="1050" width="2370" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_mail_di" bpmnElement="P_mail" isHorizontal="true"><dc:Bounds x="40" y="1240" width="2400" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_start_di" bpmnElement="a_start">
        <dc:Bounds x="92" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="67" y="192" width="85" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_fill_di" bpmnElement="a_fill">
        <dc:Bounds x="180" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_send_di" bpmnElement="a_send">
        <dc:Bounds x="310" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_wait_di" bpmnElement="a_wait">
        <dc:Bounds x="1732" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1718" y="106" width="63" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_gw_di" bpmnElement="a_gw" isMarkerVisible="true">
        <dc:Bounds x="1855" y="145" width="50" height="50" />
