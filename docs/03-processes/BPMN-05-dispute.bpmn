<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_buyer" name="Покупатель" processRef="Process_buyer" />
    <bpmn:participant id="P_seller" name="Продавец" processRef="Process_seller" />
    <bpmn:participant id="P_moder" name="Модератор" processRef="Process_moderator" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_gateway" name="Платёжный шлюз" />
    <bpmn:participant id="P_adm" name="Администратор" />
    <bpmn:messageFlow id="Msg_u_open_s_disp" name="Спор по заказу" sourceRef="u_open" targetRef="s_disp" />
    <bpmn:messageFlow id="Msg_t_open_ss_notice" name="Уведомление о споре" sourceRef="t_open" targetRef="ss_notice" />
    <bpmn:messageFlow id="Msg_u_reply_s_reply" name="Ответ продавца" sourceRef="u_reply" targetRef="s_reply" />
    <bpmn:messageFlow id="Msg_t_ready_s_mod" name="Спор модератору" sourceRef="t_ready" targetRef="s_mod" />
    <bpmn:messageFlow id="Msg_e_mod_ic_dec" name="Решение" sourceRef="e_mod" targetRef="ic_dec" />
    <bpmn:messageFlow id="Msg_t_close_bs_res" name="Решение по спору" sourceRef="t_close" targetRef="bs_res" />
    <bpmn:messageFlow id="Msg_t_close_ss_res" name="Решение по спору" sourceRef="t_close" targetRef="ss_res" />
    <bpmn:messageFlow id="Msg_t_refund_P_gateway" name="Запрос возврата" sourceRef="t_refund" targetRef="P_gateway" />
    <bpmn:messageFlow id="Msg_P_gateway_im_ref" name="Возврат выполнен" sourceRef="P_gateway" targetRef="im_ref" />
    <bpmn:messageFlow id="Msg_e_ref_fail_P_adm" name="Возврат в очередь" sourceRef="e_ref_fail" targetRef="P_adm" />
    <bpmn:messageFlow id="Msg_P_adm_ms_adm" name="Возврат вручную" sourceRef="P_adm" targetRef="ms_adm" />
  </bpmn:collaboration>
  <bpmn:process id="Process_buyer" isExecutable="false">
    <bpmn:startEvent id="b_start" name="Покупатель недоволен выданным ключом">
      <bpmn:outgoing>Flow_b_start_u_open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u_open" name="Открыть спор и указать причину">
      <bpmn:documentation>FT-8.0: в течение 72 часов после выдачи, причина обязательна.</bpmn:documentation>
      <bpmn:incoming>Flow_b_start_u_open</bpmn:incoming>
      <bpmn:outgoing>Flow_u_open_e_sent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_sent" name="Спор отправлен">
      <bpmn:incoming>Flow_u_open_e_sent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_res" name="Решение по спору получено">
      <bpmn:documentation>FT-11.0: покупатель получает письмо о статусе спора.</bpmn:documentation>
      <bpmn:outgoing>Flow_bs_res_be_res</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_res_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="be_res" name="Покупатель проинформирован">
      <bpmn:incoming>Flow_bs_res_be_res</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b_start_u_open" sourceRef="b_start" targetRef="u_open" />
    <bpmn:sequenceFlow id="Flow_u_open_e_sent" sourceRef="u_open" targetRef="e_sent" />
    <bpmn:sequenceFlow id="Flow_bs_res_be_res" sourceRef="bs_res" targetRef="be_res" />
  </bpmn:process>
  <bpmn:process id="Process_seller" isExecutable="false">
    <bpmn:startEvent id="ss_notice" name="Уведомление о споре получено">
      <bpmn:outgoing>Flow_ss_notice_u_reply</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ss_notice_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="u_reply" name="Ответить на спор">
      <bpmn:documentation>FT-8.1: продавец может ответить, ответ виден модератору.</bpmn:documentation>
      <bpmn:incoming>Flow_ss_notice_u_reply</bpmn:incoming>
      <bpmn:outgoing>Flow_u_reply_e_reply</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_reply" name="Ответ отправлен">
      <bpmn:incoming>Flow_u_reply_e_reply</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ss_res" name="Решение по спору получено">
      <bpmn:outgoing>Flow_ss_res_se_res</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ss_res_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="se_res" name="Продавец проинформирован">
      <bpmn:incoming>Flow_ss_res_se_res</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ss_notice_u_reply" sourceRef="ss_notice" targetRef="u_reply" />
    <bpmn:sequenceFlow id="Flow_u_reply_e_reply" sourceRef="u_reply" targetRef="e_reply" />
    <bpmn:sequenceFlow id="Flow_ss_res_se_res" sourceRef="ss_res" targetRef="se_res" />
  </bpmn:process>
  <bpmn:process id="Process_moderator" isExecutable="false">
    <bpmn:startEvent id="s_mod" name="Спор ожидает решения">
      <bpmn:outgoing>Flow_s_mod_u_decide</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_mod_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="u_decide" name="Принять решение по спору">
      <bpmn:documentation>FT-8.2: возврат, отказ в возврате или замена ключа. Срок 24 часа с открытия спора.</bpmn:documentation>
      <bpmn:incoming>Flow_s_mod_u_decide</bpmn:incoming>
      <bpmn:outgoing>Flow_u_decide_e_mod</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_24h" attachedToRef="u_decide" cancelActivity="false">
      <bpmn:outgoing>Flow_b_24h_e_alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="b_24h_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_alert" name="Администратор оповещён о просрочке">
      <bpmn:documentation>NFT-6.1: метрика сроков и оповещение. Спор остаётся в очереди.</bpmn:documentation>
      <bpmn:incoming>Flow_b_24h_e_alert</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_alert_def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e_mod" name="Решение принято">
      <bpmn:incoming>Flow_u_decide_e_mod</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_mod_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_mod_u_decide" sourceRef="s_mod" targetRef="u_decide" />
    <bpmn:sequenceFlow id="Flow_u_decide_e_mod" sourceRef="u_decide" targetRef="e_mod" />
    <bpmn:sequenceFlow id="Flow_b_24h_e_alert" sourceRef="b_24h" targetRef="e_alert" />
    <bpmn:textAnnotation id="Note_24h"><bpmn:text>Срок решения 24 часа считается с открытия спора, ответ продавца решение не задерживает. При просрочке администратор получает оповещение, спор остаётся в очереди, деньги заморожены (NFT-6.1). Если спор возвращён модератору, срок начинается заново</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_24h" sourceRef="Note_24h" targetRef="e_alert" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_disputes" name="Споры">
        <bpmn:flowNodeRef>s_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_win</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lc_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ic_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_saved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_balance" name="Баланс продавцов">
        <bpmn:flowNodeRef>t_freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_release</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_delivery" name="Выдача">
        <bpmn:flowNodeRef>t_replace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lt_back</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_payments" name="Платежи">
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ref_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ms_adm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refunded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_disp" name="Спор от покупателя">
      <bpmn:outgoing>Flow_s_disp_g_win</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_disp_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_win" name="Окно открыто, спор первый?">
      <bpmn:documentation>FT-8.0: не больше 72 часов после первичного перехода заказа в «выдан». FT-8.5: на заказ открывается один спор.</bpmn:documentation>
      <bpmn:incoming>Flow_s_disp_g_win</bpmn:incoming>
      <bpmn:outgoing>Flow_g_win_t_open</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_win_t_deny</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_deny" name="Отклонить спор: срок истёк или спор уже был">
      <bpmn:documentation>FT-8.0: окно 72 часа после первичного перехода заказа в «выдан». FT-8.5: повторный спор по заказу не открывается.</bpmn:documentation>
      <bpmn:incoming>Flow_g_win_t_deny</bpmn:incoming>
      <bpmn:outgoing>Flow_t_deny_e_deny</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_deny" name="Спор отклонён">
      <bpmn:incoming>Flow_t_deny_e_deny</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_open" name="Создать спор «открыт», уведомить продавца">
      <bpmn:documentation>SM-09: -&gt; открыт. FT-8.1: продавцу уходит уведомление (и webhook, FT-10.3).</bpmn:documentation>
      <bpmn:incoming>Flow_g_win_t_open</bpmn:incoming>
      <bpmn:outgoing>Flow_t_open_t_freeze</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ready" name="Спор «ожидает решения», передать модератору">
      <bpmn:documentation>SM-09: открыт -&gt; ожидает решения. Срок решения 24 часа с открытия спора. При возврате спора модератору (нет ключа для замены) срок 24 часа начинается заново.</bpmn:documentation>
      <bpmn:incoming>Flow_t_freeze_t_ready</bpmn:incoming>
      <bpmn:incoming>Flow_lc_back_t_ready</bpmn:incoming>
      <bpmn:outgoing>Flow_t_ready_ic_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="lc_back" name="Спор возвращён модератору">
      <bpmn:outgoing>Flow_lc_back_t_ready</bpmn:outgoing>
      <bpmn:linkEventDefinition id="lc_back_def" name="Повторное решение" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ic_dec" name="Решение модератора получено">
      <bpmn:incoming>Flow_t_ready_ic_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_ic_dec_t_audit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ic_dec_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_audit" name="Записать решение в журнал аудита">
      <bpmn:documentation>FT-11.2, NFT-5.3.</bpmn:documentation>
      <bpmn:incoming>Flow_ic_dec_t_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_audit_g_ref</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_ref" name="Возврат?">
      <bpmn:incoming>Flow_t_audit_g_ref</bpmn:incoming>
      <bpmn:outgoing>Flow_g_ref_g_rep</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_ref_t_refund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_rep" name="Замена ключа?">
      <bpmn:incoming>Flow_g_ref_g_rep</bpmn:incoming>
      <bpmn:outgoing>Flow_g_rep_t_replace</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_rep_t_release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_close" name="Спор «решён», уведомить участников">
      <bpmn:documentation>SM-09: -&gt; решён. FT-11.0: покупателю письмо о статусе спора. FT-10.3: продавцу уведомление.</bpmn:documentation>
      <bpmn:incoming>Flow_t_release_t_close</bpmn:incoming>
      <bpmn:incoming>Flow_t_replace_t_close</bpmn:incoming>
      <bpmn:incoming>Flow_t_refunded_t_close</bpmn:incoming>
      <bpmn:outgoing>Flow_t_close_e_closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_closed" name="Спор решён">
      <bpmn:incoming>Flow_t_close_e_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_reply" name="Ответ продавца получен">
      <bpmn:outgoing>Flow_s_reply_t_save</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_reply_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_save" name="Сохранить ответ продавца к спору">
      <bpmn:incoming>Flow_s_reply_t_save</bpmn:incoming>
      <bpmn:outgoing>Flow_t_save_e_saved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_saved" name="Ответ сохранён">
      <bpmn:incoming>Flow_t_save_e_saved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_freeze" name="Заморозить деньги по заказу">
      <bpmn:documentation>FT-8.3, SM-11: пока спор открыт, деньги не становятся доступными к выводу. Операция по балансу «заморожена», причина «спор».</bpmn:documentation>
      <bpmn:incoming>Flow_t_open_t_freeze</bpmn:incoming>
      <bpmn:outgoing>Flow_t_freeze_t_ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_release" name="Снять заморозку, деньги доступны по сроку удержания">
      <bpmn:documentation>FT-9.2, SM-11: заморожена (спор) -&gt; доступна, если 7 дней после первичной выдачи уже прошли, иначе -&gt; заморожена (удержание) до срока, дальше по таймеру BPMN-06.</bpmn:documentation>
      <bpmn:incoming>Flow_g_rep_t_release</bpmn:incoming>
      <bpmn:outgoing>Flow_t_release_t_close</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_replace" name="Выдать новый ключ (пул или API), аннулировать прежний">
      <bpmn:documentation>FT-8.6: для товара с пулом ключ берётся из пула, для товара с выдачей по API запрашивается у продавца (механизм FT-7.4, ответ ждём 10 минут). SM-03: прежний ключ -&gt; аннулирован, новый -&gt; выдан. SM-06: выдача типа «повторная». Окна поддержки, спора и удержания не сдвигаются.</bpmn:documentation>
      <bpmn:incoming>Flow_g_rep_t_replace</bpmn:incoming>
      <bpmn:outgoing>Flow_t_replace_t_close</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="be_rep" attachedToRef="t_replace">
      <bpmn:outgoing>Flow_be_rep_lt_back</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_rep_def" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="lt_back" name="Ключа нет: спор возвращается модератору">
      <bpmn:documentation>FT-8.6: нет свободного ключа или продавец не ответил за 10 минут. Спор снова «ожидает решения», модератор принимает новое решение (например, возврат), срок 24 часа начинается заново.</bpmn:documentation>
      <bpmn:incoming>Flow_be_rep_lt_back</bpmn:incoming>
      <bpmn:linkEventDefinition id="lt_back_def" name="Повторное решение" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_refund" name="Запросить возврат у шлюза">
      <bpmn:documentation>FT-8.4, FT-6.4: тот же механизм, что автовозврат: идемпотентно, при сбое повтор, при исчерпании попыток очередь администратора.</bpmn:documentation>
      <bpmn:incoming>Flow_g_ref_t_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_t_refund_im_ref</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="be_ref" attachedToRef="t_refund">
      <bpmn:outgoing>Flow_be_ref_e_ref_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_ref_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_ref_fail" name="Возврат передан в очередь администратора">
      <bpmn:documentation>FT-6.4: попытки исчерпаны. Решение модератора обязательно к исполнению: администратор возвращает деньги вручную в кабинете шлюза и отмечает возврат в платформе.</bpmn:documentation>
      <bpmn:incoming>Flow_be_ref_e_ref_fail</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_ref_fail_def" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ms_adm" name="Администратор отметил возврат выполненным">
      <bpmn:documentation>FT-6.4: ручной возврат подтверждён. Дальше как при возврате через шлюз: платёж и заказ «возвращены», сторно в балансе.</bpmn:documentation>
      <bpmn:outgoing>Flow_ms_adm_t_refunded</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ms_adm_def" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="im_ref" name="Возврат выполнен">
      <bpmn:incoming>Flow_t_refund_im_ref</bpmn:incoming>
      <bpmn:outgoing>Flow_im_ref_t_refunded</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_ref_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_refunded" name="Платёж и заказ «возвращён», начисление и комиссия сторнированы">
      <bpmn:documentation>SM-02: подтверждён -&gt; возвращён. SM-01: выдан -&gt; возвращён. FT-9.5: при возврате комиссия платформы не взимается, начисление продавцу и комиссия сторнируются целиком. FT-9.4: движение по балансу пишется в неизменяемый журнал.</bpmn:documentation>
      <bpmn:incoming>Flow_im_ref_t_refunded</bpmn:incoming>
      <bpmn:incoming>Flow_ms_adm_t_refunded</bpmn:incoming>
