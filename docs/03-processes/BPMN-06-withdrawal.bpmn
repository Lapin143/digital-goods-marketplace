<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_seller" name="Продавец" processRef="Process_seller" />
    <bpmn:participant id="P_admin" name="Администратор" processRef="Process_admin" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_email" name="E-mail-провайдер" />
    <bpmn:messageFlow id="Msg_u_req_s_req" name="Заявка на вывод" sourceRef="u_req" targetRef="s_req" />
    <bpmn:messageFlow id="Msg_t_create_s_adm" name="Новая заявка" sourceRef="t_create" targetRef="s_adm" />
    <bpmn:messageFlow id="Msg_e_adm_ic_adm" name="Решение по заявке" sourceRef="e_adm" targetRef="ic_adm" />
    <bpmn:messageFlow id="Msg_t_notify_ss_res" name="Статус заявки" sourceRef="t_notify" targetRef="ss_res" />
    <bpmn:messageFlow id="Msg_t_mail_P_email" name="Письмо с результатом" sourceRef="t_mail" targetRef="P_email" />
    <bpmn:messageFlow id="Msg_P_email_bs_mail" name="Письмо в почтовом ящике" sourceRef="P_email" targetRef="bs_mail" />
  </bpmn:collaboration>
  <bpmn:process id="Process_seller" isExecutable="false">
    <bpmn:startEvent id="b_start" name="Продавцу нужны деньги">
      <bpmn:outgoing>Flow_b_start_u_req</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u_req" name="Подать заявку на вывод, указать сумму">
      <bpmn:documentation>FT-9.3: заявка от 1 000 ₽. Реквизиты берутся из профиля продавца.</bpmn:documentation>
      <bpmn:incoming>Flow_b_start_u_req</bpmn:incoming>
      <bpmn:outgoing>Flow_u_req_e_sent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_sent" name="Заявка отправлена">
      <bpmn:incoming>Flow_u_req_e_sent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ss_res" name="Статус заявки в кабинете получен">
      <bpmn:outgoing>Flow_ss_res_se_res</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ss_res_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="se_res" name="Продавец проинформирован">
      <bpmn:incoming>Flow_ss_res_se_res</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_mail" name="Письмо о результате получено">
      <bpmn:documentation>FT-11.4: продавец получает письмо о результате заявки, при отказе с причиной.</bpmn:documentation>
      <bpmn:outgoing>Flow_bs_mail_be_mail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_mail_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="be_mail" name="Продавец уведомлён по e-mail">
      <bpmn:incoming>Flow_bs_mail_be_mail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b_start_u_req" sourceRef="b_start" targetRef="u_req" />
    <bpmn:sequenceFlow id="Flow_u_req_e_sent" sourceRef="u_req" targetRef="e_sent" />
    <bpmn:sequenceFlow id="Flow_ss_res_se_res" sourceRef="ss_res" targetRef="se_res" />
    <bpmn:sequenceFlow id="Flow_bs_mail_be_mail" sourceRef="bs_mail" targetRef="be_mail" />
  </bpmn:process>
  <bpmn:process id="Process_admin" isExecutable="false">
    <bpmn:startEvent id="s_adm" name="Новая заявка на вывод">
      <bpmn:outgoing>Flow_s_adm_u_check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_adm_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="u_check" name="Проверить заявку и реквизиты">
      <bpmn:documentation>SM-10: создана -&gt; на проверке, когда администратор берёт заявку. Заявки обрабатываются вручную (FT-9.3). Срок обработки не более 3 суток.</bpmn:documentation>
      <bpmn:incoming>Flow_s_adm_u_check</bpmn:incoming>
      <bpmn:outgoing>Flow_u_check_g_ok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_3d" attachedToRef="u_check" cancelActivity="false">
      <bpmn:outgoing>Flow_b_3d_e_alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="b_3d_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_alert" name="Оповещение о просрочке заявки">
      <bpmn:documentation>FT-9.3, NFT-6.1: заявка не обработана за 3 суток. Администраторы получают оповещение, заявка остаётся в очереди, резерв сохраняется.</bpmn:documentation>
      <bpmn:incoming>Flow_b_3d_e_alert</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_alert_def" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_ok" name="Заявку можно выплатить?">
      <bpmn:incoming>Flow_u_check_g_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_g_ok_u_pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_ok_u_rej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_pay" name="Перевести деньги вручную вне платформы">
      <bpmn:documentation>FT-9.3: платформа деньги не переводит. Администратор переводит сумму по сохранённым в заявке реквизитам. Повторные попытки перевода он делает внутри этой задачи.</bpmn:documentation>
      <bpmn:incoming>Flow_g_ok_u_pay</bpmn:incoming>
      <bpmn:outgoing>Flow_u_pay_g_bank</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_bank" name="Перевод принят банком?">
      <bpmn:incoming>Flow_u_pay_g_bank</bpmn:incoming>
      <bpmn:outgoing>Flow_g_bank_u_mark</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_bank_u_rej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_mark" name="Отметить заявку выплаченной">
      <bpmn:documentation>FT-9.3: администратор подтверждает выплату в кабинете.</bpmn:documentation>
      <bpmn:incoming>Flow_g_bank_u_mark</bpmn:incoming>
      <bpmn:outgoing>Flow_u_mark_e_adm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="u_rej" name="Отклонить заявку и указать причину">
      <bpmn:documentation>FT-9.3: причина отказа обязательна (неверные реквизиты, перевод не принят банком, иная причина), продавец её видит.</bpmn:documentation>
      <bpmn:incoming>Flow_g_ok_u_rej</bpmn:incoming>
      <bpmn:incoming>Flow_g_bank_u_rej</bpmn:incoming>
      <bpmn:outgoing>Flow_u_rej_e_adm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_adm" name="Решение принято">
      <bpmn:incoming>Flow_u_mark_e_adm</bpmn:incoming>
      <bpmn:incoming>Flow_u_rej_e_adm</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_adm_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_adm_u_check" sourceRef="s_adm" targetRef="u_check" />
    <bpmn:sequenceFlow id="Flow_u_check_g_ok" sourceRef="u_check" targetRef="g_ok" />
    <bpmn:sequenceFlow id="Flow_g_ok_u_pay" name="да" sourceRef="g_ok" targetRef="u_pay" />
    <bpmn:sequenceFlow id="Flow_g_ok_u_rej" name="нет" sourceRef="g_ok" targetRef="u_rej" />
    <bpmn:sequenceFlow id="Flow_u_pay_g_bank" sourceRef="u_pay" targetRef="g_bank" />
    <bpmn:sequenceFlow id="Flow_g_bank_u_mark" name="да" sourceRef="g_bank" targetRef="u_mark" />
    <bpmn:sequenceFlow id="Flow_g_bank_u_rej" name="нет" sourceRef="g_bank" targetRef="u_rej" />
    <bpmn:sequenceFlow id="Flow_b_3d_e_alert" sourceRef="b_3d" targetRef="e_alert" />
    <bpmn:sequenceFlow id="Flow_u_mark_e_adm" sourceRef="u_mark" targetRef="e_adm" />
    <bpmn:sequenceFlow id="Flow_u_rej_e_adm" sourceRef="u_rej" targetRef="e_adm" />
    <bpmn:textAnnotation id="Note_3d"><bpmn:text>Срок обработки заявки не более 3 суток (FT-9.3). При просрочке администраторы получают оповещение, заявка остаётся в очереди (NFT-6.1)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_3d" sourceRef="Note_3d" targetRef="e_alert" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_notify" name="Уведомления">
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ntf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_balance" name="Баланс продавцов">
        <bpmn:flowNodeRef>s_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_amt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ic_adm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_accrue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ic_hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_frozen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_audit" name="Аудит и администрирование">
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="t_notify" name="Показать статус заявки в кабинете">
      <bpmn:documentation>FT-9.3: продавец видит статус заявки и причину отказа в кабинете.</bpmn:documentation>
      <bpmn:incoming>Flow_t_paid_t_notify</bpmn:incoming>
      <bpmn:incoming>Flow_t_back_t_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_t_notify_t_mail</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="t_mail" name="Отправить продавцу письмо с результатом">
      <bpmn:documentation>FT-11.4: продавец получает письмо о результате заявки, при отказе с причиной.</bpmn:documentation>
      <bpmn:incoming>Flow_t_notify_t_mail</bpmn:incoming>
      <bpmn:outgoing>Flow_t_mail_e_ntf</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e_ntf" name="Продавец уведомлён">
      <bpmn:incoming>Flow_t_mail_e_ntf</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_req" name="Заявка на вывод">
      <bpmn:outgoing>Flow_s_req_g_amt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_req_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_amt" name="Сумма от 1 000 ₽, не больше доступной, продавец не заблокирован?">
      <bpmn:documentation>FT-9.3: минимум 1 000 ₽, не больше доступного остатка. FT-2.3, FT-9.3: заблокированный продавец заявку подать не может.</bpmn:documentation>
      <bpmn:incoming>Flow_s_req_g_amt</bpmn:incoming>
      <bpmn:outgoing>Flow_g_amt_t_create</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_amt_t_inv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_inv" name="Отклонить заявку, показать причину на форме">
      <bpmn:documentation>FT-9.3: сумма вне пределов или продавец заблокирован. Продавец видит причину сразу, заявка не создаётся.</bpmn:documentation>
      <bpmn:incoming>Flow_g_amt_t_inv</bpmn:incoming>
      <bpmn:outgoing>Flow_t_inv_e_inv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_inv" name="Заявка не создана">
      <bpmn:incoming>Flow_t_inv_e_inv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_create" name="Создать заявку «создана», сохранить реквизиты, зарезервировать сумму, записать в журнал">
      <bpmn:documentation>SM-10: -&gt; создана. В заявке сохраняется снимок реквизитов (правка профиля позже их не меняет). Сумма резервируется: операция «вывод» «заморожена» (причина «резерв под вывод»), доступный остаток уменьшается (SM-11, FT-9.4).</bpmn:documentation>
      <bpmn:incoming>Flow_g_amt_t_create</bpmn:incoming>
      <bpmn:outgoing>Flow_t_create_ic_adm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="ic_adm" name="Решение администратора получено">
      <bpmn:incoming>Flow_t_create_ic_adm</bpmn:incoming>
      <bpmn:outgoing>Flow_ic_adm_t_audit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ic_adm_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_audit" name="Записать действие администратора в журнал аудита">
      <bpmn:documentation>FT-11.2, NFT-5.3: журнал без персональных данных в открытом виде.</bpmn:documentation>
      <bpmn:incoming>Flow_ic_adm_t_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_audit_g_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dec" name="Выплачена?">
      <bpmn:incoming>Flow_t_audit_g_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_g_dec_t_paid</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_dec_t_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_paid" name="Заявка «выплачена», операция «вывод» «выплачена», записать в журнал">
      <bpmn:documentation>SM-10: на проверке -&gt; выплачена. SM-11: вывод заморожена -&gt; выплачена. FT-9.4.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_paid</bpmn:incoming>
      <bpmn:outgoing>Flow_t_paid_t_notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_back" name="Заявка «отклонена», резерв снят, сумма снова доступна, записать в журнал">
      <bpmn:documentation>SM-10: на проверке -&gt; отклонена, причина сохраняется. SM-11: вывод заморожена -&gt; сторнирована. Резерв снимается, в журнале новая запись, прежняя не меняется (FT-9.4).</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_back</bpmn:incoming>
      <bpmn:outgoing>Flow_t_back_t_notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s_acc" name="Заказ впервые выдан">
      <bpmn:outgoing>Flow_s_acc_t_accrue</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_acc_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_accrue" name="Начислить сумму заказа за вычетом комиссии, записать в журнал">
      <bpmn:documentation>FT-9.0, FT-9.2: операции «начисление» и «комиссия» «заморожена» (причина «удержание»), «доступна с» = дата первичной выдачи + 7 дней. SM-11, FT-9.4.</bpmn:documentation>
      <bpmn:incoming>Flow_s_acc_t_accrue</bpmn:incoming>
      <bpmn:outgoing>Flow_t_accrue_ic_hold</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="ic_hold" name="7 дней с первичной выдачи">
      <bpmn:incoming>Flow_t_accrue_ic_hold</bpmn:incoming>
      <bpmn:outgoing>Flow_ic_hold_g_dsp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ic_hold_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_dsp" name="Открыт спор по заказу?">
      <bpmn:incoming>Flow_ic_hold_g_dsp</bpmn:incoming>
      <bpmn:outgoing>Flow_g_dsp_t_avail</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_dsp_e_frozen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_avail" name="Перевести деньги в «доступна», записать в журнал">
      <bpmn:documentation>FT-9.2: деньги доступны к выводу. SM-11: заморожена -&gt; доступна.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dsp_t_avail</bpmn:incoming>
      <bpmn:outgoing>Flow_t_avail_e_avail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_avail" name="Деньги доступны к выводу">
      <bpmn:incoming>Flow_t_avail_e_avail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_frozen" name="Деньги заморожены до решения спора (BPMN-05)">
      <bpmn:documentation>FT-8.3: пока спор открыт, деньги по заказу недоступны. После решения спора процесс BPMN-05 переводит деньги в «доступна» (если 7 дней уже прошли) или возвращает их покупателю.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dsp_e_frozen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_req_g_amt" sourceRef="s_req" targetRef="g_amt" />
    <bpmn:sequenceFlow id="Flow_g_amt_t_create" name="да" sourceRef="g_amt" targetRef="t_create" />
    <bpmn:sequenceFlow id="Flow_g_amt_t_inv" name="нет" sourceRef="g_amt" targetRef="t_inv" />
    <bpmn:sequenceFlow id="Flow_t_inv_e_inv" sourceRef="t_inv" targetRef="e_inv" />
    <bpmn:sequenceFlow id="Flow_t_create_ic_adm" sourceRef="t_create" targetRef="ic_adm" />
    <bpmn:sequenceFlow id="Flow_ic_adm_t_audit" sourceRef="ic_adm" targetRef="t_audit" />
    <bpmn:sequenceFlow id="Flow_t_audit_g_dec" sourceRef="t_audit" targetRef="g_dec" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_paid" name="да" sourceRef="g_dec" targetRef="t_paid" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_back" name="нет" sourceRef="g_dec" targetRef="t_back" />
    <bpmn:sequenceFlow id="Flow_t_paid_t_notify" sourceRef="t_paid" targetRef="t_notify" />
    <bpmn:sequenceFlow id="Flow_t_back_t_notify" sourceRef="t_back" targetRef="t_notify" />
    <bpmn:sequenceFlow id="Flow_t_notify_t_mail" sourceRef="t_notify" targetRef="t_mail" />
    <bpmn:sequenceFlow id="Flow_t_mail_e_ntf" sourceRef="t_mail" targetRef="e_ntf" />
    <bpmn:sequenceFlow id="Flow_s_acc_t_accrue" sourceRef="s_acc" targetRef="t_accrue" />
    <bpmn:sequenceFlow id="Flow_t_accrue_ic_hold" sourceRef="t_accrue" targetRef="ic_hold" />
    <bpmn:sequenceFlow id="Flow_ic_hold_g_dsp" sourceRef="ic_hold" targetRef="g_dsp" />
    <bpmn:sequenceFlow id="Flow_g_dsp_t_avail" name="нет" sourceRef="g_dsp" targetRef="t_avail" />
    <bpmn:sequenceFlow id="Flow_t_avail_e_avail" sourceRef="t_avail" targetRef="e_avail" />
    <bpmn:sequenceFlow id="Flow_g_dsp_e_frozen" name="да" sourceRef="g_dsp" targetRef="e_frozen" />
