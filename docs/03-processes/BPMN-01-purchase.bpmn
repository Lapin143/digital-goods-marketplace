    <bpmn:textAnnotation id="Note_late"><bpmn:text>Поздняя оплата: за это время ключи могли уйти другому покупателю (FT-6.5)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_late" sourceRef="Note_late" targetRef="s_late" />
