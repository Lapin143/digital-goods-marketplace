<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_buyer" name="Покупатель" processRef="Process_buyer" />
    <bpmn:participant id="P_gateway" name="Платёжный шлюз" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_mail" name="E-mail-провайдер" />
    <bpmn:messageFlow id="Msg_b_order_s_order" name="Запрос на оформление" sourceRef="b_order" targetRef="s_order" />
    <bpmn:messageFlow id="Msg_t_session_P_gateway" name="Создать платёж" sourceRef="t_session" targetRef="P_gateway" />
    <bpmn:messageFlow id="Msg_b_pay_P_gateway" name="Оплата (данные карты только шлюзу)" sourceRef="b_pay" targetRef="P_gateway" />
    <bpmn:messageFlow id="Msg_P_gateway_im_ok" name="Уведомление об оплате" sourceRef="P_gateway" targetRef="im_ok" />
    <bpmn:messageFlow id="Msg_P_gateway_im_rej" name="Отказ в оплате" sourceRef="P_gateway" targetRef="im_rej" />
    <bpmn:messageFlow id="Msg_P_gateway_s_late" name="Повтор или поздняя оплата" sourceRef="P_gateway" targetRef="s_late" />
    <bpmn:messageFlow id="Msg_t_refund_P_gateway" name="Запрос возврата" sourceRef="t_refund" targetRef="P_gateway" />
    <bpmn:messageFlow id="Msg_P_gateway_im_refund_ok" name="Возврат выполнен" sourceRef="P_gateway" targetRef="im_refund_ok" />
    <bpmn:messageFlow id="Msg_t_send_P_mail" name="Письмо с ключом" sourceRef="t_send" targetRef="P_mail" />
    <bpmn:messageFlow id="Msg_P_mail_im_undel" name="Недоставка" sourceRef="P_mail" targetRef="im_undel" />
    <bpmn:messageFlow id="Msg_P_mail_im_deliv" name="Доставка подтверждена" sourceRef="P_mail" targetRef="im_deliv" />
    <bpmn:messageFlow id="Msg_P_mail_b_got" name="Письмо в
почтовом ящике" sourceRef="P_mail" targetRef="b_got" />
  </bpmn:collaboration>
  <bpmn:process id="Process_buyer" isExecutable="false">
    <bpmn:startEvent id="b_start" name="Покупатель выбрал товар">
      <bpmn:outgoing>Flow_b_start_b_order</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="b_order" name="Оформить заказ из карточки товара">
      <bpmn:incoming>Flow_b_start_b_order</bpmn:incoming>
      <bpmn:outgoing>Flow_b_order_b_pay</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="b_pay" name="Оплатить заказ на странице шлюза">
      <bpmn:documentation>Данные карты вводятся только на стороне шлюза и на платформу не попадают (FT-6.0, NFT-5.1).</bpmn:documentation>
      <bpmn:incoming>Flow_b_order_b_pay</bpmn:incoming>
      <bpmn:outgoing>Flow_b_pay_b_got</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="b_got" name="Письмо с ключом получено">
      <bpmn:incoming>Flow_b_pay_b_got</bpmn:incoming>
      <bpmn:outgoing>Flow_b_got_b_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="b_got_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="b_end" name="Покупатель получил ключ">
      <bpmn:incoming>Flow_b_got_b_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b_start_b_order" sourceRef="b_start" targetRef="b_order" />
    <bpmn:sequenceFlow id="Flow_b_order_b_pay" sourceRef="b_order" targetRef="b_pay" />
    <bpmn:sequenceFlow id="Flow_b_pay_b_got" sourceRef="b_pay" targetRef="b_got" />
    <bpmn:sequenceFlow id="Flow_b_got_b_end" sourceRef="b_got" targetRef="b_end" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_payments" name="Платежи">
        <bpmn:flowNodeRef>t_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>it_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_refund_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ms_adm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_refund_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refunded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_refunded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_orders" name="Заказы">
        <bpmn:flowNodeRef>s_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lt_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_late_paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_stock" name="Остатки и ключи">
        <bpmn:flowNodeRef>t_reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nostock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lc_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_keys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_keys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_re</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_delivery" name="Выдача">
        <bpmn:flowNodeRef>t_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_undel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>it_30</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_support" name="Поддержка">
        <bpmn:flowNodeRef>t_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_queued</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_order" name="Запрос на оформление заказа">
      <bpmn:documentation>FT-5.0, FT-5.1: заказ из карточки товара, один товар, количество 1-10.</bpmn:documentation>
      <bpmn:outgoing>Flow_s_order_g_phone</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_order_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_phone" name="Телефон подтверждён?">
      <bpmn:incoming>Flow_s_order_g_phone</bpmn:incoming>
      <bpmn:outgoing>Flow_g_phone_m_phone</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_phone_sp_phone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_phone" name="Подтвердить телефон (код из SMS)">
      <bpmn:documentation>FT-1.5, NFT-3.7: код одноразовый, 5 минут, 5 попыток. Выбранный товар и количество сохраняются.</bpmn:documentation>
      <bpmn:incoming>Flow_g_phone_sp_phone</bpmn:incoming>
      <bpmn:outgoing>Flow_sp_phone_m_phone</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="be_phone" attachedToRef="sp_phone">
      <bpmn:outgoing>Flow_be_phone_e_phone</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_phone_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_phone" name="Оформление прервано: телефон не подтверждён">
      <bpmn:documentation>Заказ не создан.</bpmn:documentation>
      <bpmn:incoming>Flow_be_phone_e_phone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="m_phone">
      <bpmn:incoming>Flow_g_phone_m_phone</bpmn:incoming>
      <bpmn:incoming>Flow_sp_phone_m_phone</bpmn:incoming>
      <bpmn:outgoing>Flow_m_phone_t_create</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_create" name="Создать заказ (статус «создан»)">
      <bpmn:documentation>SM-01: создан. Снимок e-mail покупателя фиксируется в заказе.</bpmn:documentation>
      <bpmn:incoming>Flow_m_phone_t_create</bpmn:incoming>
      <bpmn:outgoing>Flow_t_create_t_reserve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_cancel">
      <bpmn:incoming>Flow_im_rej_j_cancel</bpmn:incoming>
      <bpmn:incoming>Flow_it_exp_j_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_j_cancel_t_release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_cancel" name="Перевести заказ в «отменён»">
      <bpmn:documentation>SM-01: ожидает оплаты -&gt; отменён. FT-6.3.</bpmn:documentation>
      <bpmn:incoming>Flow_t_release_t_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_t_cancel_e_cancel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_cancel" name="Заказ «отменён»">
      <bpmn:incoming>Flow_t_cancel_e_cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_paid" name="Перевести заказ в «оплачен»">
      <bpmn:documentation>SM-01: ожидает оплаты -&gt; оплачен.</bpmn:documentation>
      <bpmn:incoming>Flow_t_confirm_t_paid</bpmn:incoming>
      <bpmn:outgoing>Flow_t_paid_j_keys</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="lt_paid" name="Оплата учтена">
      <bpmn:incoming>Flow_t_late_paid_lt_paid</bpmn:incoming>
      <bpmn:linkEventDefinition id="lt_paid_def" name="Оплата учтена" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_late_paid" name="Вернуть заказ из «отменён» в «оплачен»">
      <bpmn:documentation>SM-01: отменён -&gt; оплачен при успешном перерезервировании (FT-6.5).</bpmn:documentation>
      <bpmn:incoming>Flow_g_re_t_late_paid</bpmn:incoming>
      <bpmn:outgoing>Flow_t_late_paid_lt_paid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reserve" name="Зарезервировать ключи на 15 минут">
      <bpmn:documentation>FT-5.2, FT-4.4, FT-7.1: блокировка строк с пропуском занятых. Срок резерва задаёт параметр платформы.</bpmn:documentation>
      <bpmn:incoming>Flow_t_create_t_reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_t_reserve_g_stock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_stock" name="Ключей
достаточно?">
      <bpmn:incoming>Flow_t_reserve_g_stock</bpmn:incoming>
      <bpmn:outgoing>Flow_g_stock_t_session</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_stock_e_nostock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_nostock" name="Заказ «отменён»: нет остатка">
      <bpmn:documentation>SM-01: создан -&gt; отменён. Покупателю показывается сообщение об остатке.</bpmn:documentation>
      <bpmn:incoming>Flow_g_stock_e_nostock</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_release" name="Снять резерв (ключи «свободны»)">
      <bpmn:documentation>SM-03: зарезервирован -&gt; свободен. FT-6.3.</bpmn:documentation>
      <bpmn:incoming>Flow_j_cancel_t_release</bpmn:incoming>
      <bpmn:outgoing>Flow_t_release_t_cancel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="lc_paid" name="Оплата учтена">
      <bpmn:outgoing>Flow_lc_paid_j_keys</bpmn:outgoing>
      <bpmn:linkEventDefinition id="lc_paid_def" name="Оплата учтена" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="j_keys">
      <bpmn:incoming>Flow_t_paid_j_keys</bpmn:incoming>
      <bpmn:incoming>Flow_lc_paid_j_keys</bpmn:incoming>
      <bpmn:outgoing>Flow_j_keys_t_keys</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_keys" name="Перевести ключи заказа в «выдан»">
      <bpmn:documentation>SM-03: зарезервирован -&gt; выдан. FT-7.1, NFT-2.2.</bpmn:documentation>
      <bpmn:incoming>Flow_j_keys_t_keys</bpmn:incoming>
      <bpmn:outgoing>Flow_t_keys_t_form</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_re" name="Зарезервировать ключи заново">
      <bpmn:documentation>FT-6.5: повторная попытка резерва после поздней оплаты.</bpmn:documentation>
      <bpmn:incoming>Flow_g_late_t_re</bpmn:incoming>
      <bpmn:outgoing>Flow_t_re_g_re</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_re" name="Ключи есть?">
      <bpmn:incoming>Flow_t_re_g_re</bpmn:incoming>
      <bpmn:outgoing>Flow_g_re_t_late_paid</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_re_t_refund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_session" name="Открыть платёжную сессию (12 мин)">
      <bpmn:documentation>FT-5.2: сессия 12 минут, всегда короче резерва (15 минут). SM-01: создан -&gt; ожидает оплаты.</bpmn:documentation>
      <bpmn:incoming>Flow_g_stock_t_session</bpmn:incoming>
      <bpmn:outgoing>Flow_t_session_eg_pay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="eg_pay">
      <bpmn:incoming>Flow_t_session_eg_pay</bpmn:incoming>
      <bpmn:outgoing>Flow_eg_pay_im_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_eg_pay_im_rej</bpmn:outgoing>
      <bpmn:outgoing>Flow_eg_pay_it_exp</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="im_ok" name="Платёж подтверждён">
      <bpmn:incoming>Flow_eg_pay_im_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_im_ok_t_confirm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_ok_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="im_rej" name="Платёж отклонён">
      <bpmn:incoming>Flow_eg_pay_im_rej</bpmn:incoming>
      <bpmn:outgoing>Flow_im_rej_j_cancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_rej_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="it_exp" name="Резерв истёк (15 мин)">
      <bpmn:incoming>Flow_eg_pay_it_exp</bpmn:incoming>
      <bpmn:outgoing>Flow_it_exp_j_cancel</bpmn:outgoing>
      <bpmn:timerEventDefinition id="it_exp_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_confirm" name="Отметить платёж «подтверждён»">
      <bpmn:documentation>SM-02: создан -&gt; подтверждён. Идемпотентно (FT-6.2).</bpmn:documentation>
      <bpmn:incoming>Flow_im_ok_t_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_t_confirm_t_paid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s_late" name="Подтверждение платежа по заказу, который не ждёт оплаты">
      <bpmn:documentation>Повторное уведомление шлюза или поздняя оплата (FT-6.2, FT-6.5).</bpmn:documentation>
      <bpmn:outgoing>Flow_s_late_g_late</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_late_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_late" name="Заказ уже оплачен
или выдан?">
      <bpmn:incoming>Flow_s_late_g_late</bpmn:incoming>
      <bpmn:outgoing>Flow_g_late_e_dup</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_late_t_re</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_dup" name="Дубль проигнорирован">
      <bpmn:documentation>FT-6.2, NFT-2.3.</bpmn:documentation>
      <bpmn:incoming>Flow_g_late_e_dup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_refund" name="Запросить автовозврат у шлюза">
      <bpmn:documentation>FT-6.4: идемпотентный запрос возврата, при сбое шлюза повтор с задержкой.</bpmn:documentation>
      <bpmn:incoming>Flow_g_re_t_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_t_refund_im_refund_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="be_refund" attachedToRef="t_refund">
      <bpmn:outgoing>Flow_be_refund_e_refund_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_refund_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_refund_fail" name="Возврат в очередь администратора">
      <bpmn:documentation>FT-6.4: при исчерпании попыток возврат попадает в очередь администратора. Администратор возвращает деньги вручную в кабинете шлюза и отмечает возврат в платформе.</bpmn:documentation>
      <bpmn:incoming>Flow_be_refund_e_refund_fail</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_refund_fail_def" />
    </bpmn:endEvent>
    <bpmn:startEvent id="ms_adm" name="Администратор отметил возврат выполненным">
      <bpmn:documentation>FT-6.4: ручной возврат подтверждён. Дальше как при возврате через шлюз: платёж и заказ «возвращены», письмо покупателю.</bpmn:documentation>
      <bpmn:outgoing>Flow_ms_adm_t_refunded</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ms_adm_def" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="im_refund_ok" name="Возврат подтверждён">
      <bpmn:incoming>Flow_t_refund_im_refund_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_im_refund_ok_t_refunded</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_refund_ok_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_refunded" name="Заказ и платёж «возвращён», письмо покупателю">
      <bpmn:documentation>SM-02: подтверждён -&gt; возвращён. SM-01: отменён -&gt; возвращён. FT-11.0. Возврат подтверждён шлюзом или отмечен администратором вручную (FT-6.4).</bpmn:documentation>
      <bpmn:incoming>Flow_im_refund_ok_t_refunded</bpmn:incoming>
      <bpmn:incoming>Flow_ms_adm_t_refunded</bpmn:incoming>
      <bpmn:outgoing>Flow_t_refunded_e_refunded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_refunded" name="Заказ «возвращён»">
      <bpmn:incoming>Flow_t_refunded_e_refunded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_form" name="Сформировать письмо с ключами">
      <bpmn:documentation>SM-06: в очереди.</bpmn:documentation>
      <bpmn:incoming>Flow_t_keys_t_form</bpmn:incoming>
      <bpmn:outgoing>Flow_t_form_t_send</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_send" name="Передать письмо провайдеру">
      <bpmn:documentation>NFT-2.0: не более 60 секунд от подтверждения оплаты.</bpmn:documentation>
      <bpmn:incoming>Flow_t_form_t_send</bpmn:incoming>
      <bpmn:incoming>Flow_t_wait_t_send</bpmn:incoming>
      <bpmn:outgoing>Flow_t_send_g_acc</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_acc" name="Провайдер принял письмо?">
      <bpmn:incoming>Flow_t_send_g_acc</bpmn:incoming>
      <bpmn:outgoing>Flow_g_acc_t_sent</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_acc_g_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_sent" name="Выдача «отправлено», заказ «выдан»">
      <bpmn:documentation>SM-06: в очереди -&gt; отправлено. SM-01: оплачен -&gt; выдан. Открывает окна: поддержка 72 ч, спор 72 ч, удержание 7 дней.</bpmn:documentation>
      <bpmn:incoming>Flow_g_acc_t_sent</bpmn:incoming>
      <bpmn:outgoing>Flow_t_sent_eg_deliv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="eg_deliv">
      <bpmn:incoming>Flow_t_sent_eg_deliv</bpmn:incoming>
      <bpmn:outgoing>Flow_eg_deliv_im_deliv</bpmn:outgoing>
      <bpmn:outgoing>Flow_eg_deliv_im_undel</bpmn:outgoing>
      <bpmn:outgoing>Flow_eg_deliv_it_30</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="im_deliv" name="Провайдер подтвердил доставку">
      <bpmn:incoming>Flow_eg_deliv_im_deliv</bpmn:incoming>
      <bpmn:outgoing>Flow_im_deliv_t_done</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_deliv_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_done" name="Выдача «доставлено»">
      <bpmn:documentation>SM-06: отправлено -&gt; доставлено. По этому статусу измеряется BG-01.</bpmn:documentation>
      <bpmn:incoming>Flow_im_deliv_t_done</bpmn:incoming>
      <bpmn:outgoing>Flow_t_done_e_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_done" name="Доставлено (BG-01)">
      <bpmn:incoming>Flow_t_done_e_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_wait" name="Выждать и повторить (нарастающая задержка)">
      <bpmn:documentation>FT-7.3, NFT-4.3.</bpmn:documentation>
      <bpmn:incoming>Flow_g_retry_t_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_t_wait_t_send</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_retry" name="Попытки
исчерпаны?">
      <bpmn:incoming>Flow_g_acc_g_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_g_retry_t_wait</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_retry_t_err</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_err" name="Выдача «ошибка»">
      <bpmn:documentation>SM-06: -&gt; ошибка. FT-7.3.</bpmn:documentation>
      <bpmn:incoming>Flow_g_retry_t_err</bpmn:incoming>
      <bpmn:incoming>Flow_im_undel_t_err</bpmn:incoming>
      <bpmn:outgoing>Flow_t_err_t_queue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="im_undel" name="Провайдер сообщил о недоставке">
      <bpmn:incoming>Flow_eg_deliv_im_undel</bpmn:incoming>
      <bpmn:outgoing>Flow_im_undel_t_err</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_undel_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="it_30" name="30 минут с оплаты, доставки нет">
      <bpmn:documentation>NFT-2.4: через 30 минут после оплаты без выдачи и без возврата заказ попадает в очередь поддержки, администратор получает оповещение.</bpmn:documentation>
      <bpmn:incoming>Flow_eg_deliv_it_30</bpmn:incoming>
      <bpmn:outgoing>Flow_it_30_t_queue</bpmn:outgoing>
      <bpmn:timerEventDefinition id="it_30_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_queue" name="Поставить заказ в очередь поддержки и оповестить администратора">
      <bpmn:documentation>FT-7.3, NFT-2.4. Дальше процесс BPMN-04.</bpmn:documentation>
      <bpmn:incoming>Flow_t_err_t_queue</bpmn:incoming>
      <bpmn:incoming>Flow_it_30_t_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_t_queue_e_queued</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_queued" name="Заказ передан в поддержку (BPMN-04)">
      <bpmn:incoming>Flow_t_queue_e_queued</bpmn:incoming>
    </bpmn:endEvent>
