    <bpmn:textAnnotation id="Note_session"><bpmn:text>Платёжная сессия 12 мин, резерв 15 мин. Сессия всегда короче резерва: запас 3 минуты на задержку шлюза (FT-5.2)</bpmn:text></bpmn:textAnnotation>
