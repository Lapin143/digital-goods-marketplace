<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_seller" name="Продавец" processRef="Process_seller" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_email" name="E-mail-провайдер" />
    <bpmn:messageFlow id="Msg_a_create_s_create" name="Создать товар" sourceRef="a_create" targetRef="s_create" />
    <bpmn:messageFlow id="Msg_a_keys_s_keys" name="Пул ключей" sourceRef="a_keys" targetRef="s_keys" />
    <bpmn:messageFlow id="Msg_a_submit_s_submit" name="Товар на модерацию" sourceRef="a_submit" targetRef="s_submit" />
    <bpmn:messageFlow id="Msg_a_edit_s_edit" name="Правка товара" sourceRef="a_edit" targetRef="s_edit" />
    <bpmn:messageFlow id="Msg_t_status_a_catch" name="Статус и причина в кабинете" sourceRef="t_status" targetRef="a_catch" />
    <bpmn:messageFlow id="Msg_t_mail_P_email" name="Письмо с решением" sourceRef="t_mail" targetRef="P_email" />
    <bpmn:messageFlow id="Msg_P_email_bs_mail" name="Письмо в почтовом ящике" sourceRef="P_email" targetRef="bs_mail" />
  </bpmn:collaboration>
  <bpmn:process id="Process_seller" isExecutable="false">
    <bpmn:startEvent id="a_start" name="Продавец решил добавить товар">
      <bpmn:outgoing>Flow_a_start_a_create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_create" name="Создать товар: описание, цена, способ выдачи">
      <bpmn:documentation>FT-3.0: название, описание, тип, платформа, регион активации, цена, способ выдачи.</bpmn:documentation>
      <bpmn:incoming>Flow_a_start_a_create</bpmn:incoming>
      <bpmn:outgoing>Flow_a_create_a_keys</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_keys" name="Загрузить пул ключей вручную или CSV">
      <bpmn:documentation>FT-4.1: ключи можно догружать и после публикации.</bpmn:documentation>
      <bpmn:incoming>Flow_a_create_a_keys</bpmn:incoming>
      <bpmn:outgoing>Flow_a_keys_a_submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_submit" name="Отправить товар на модерацию">
      <bpmn:documentation>SM-04: черновик (или отклонён) -&gt; на модерации.</bpmn:documentation>
      <bpmn:incoming>Flow_a_keys_a_submit</bpmn:incoming>
      <bpmn:incoming>Flow_a_fix_a_submit</bpmn:incoming>
      <bpmn:outgoing>Flow_a_submit_a_catch</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="a_catch" name="Решение по товару получено">
      <bpmn:incoming>Flow_a_submit_a_catch</bpmn:incoming>
      <bpmn:outgoing>Flow_a_catch_a_xor</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_catch_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_xor" name="Какое решение?">
      <bpmn:incoming>Flow_a_catch_a_xor</bpmn:incoming>
      <bpmn:outgoing>Flow_a_xor_a_end</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_xor_a_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_fix" name="Исправить товар по причине отклонения">
      <bpmn:documentation>Продавец правит товар и отправляет его на модерацию повторно.</bpmn:documentation>
      <bpmn:incoming>Flow_a_xor_a_fix</bpmn:incoming>
      <bpmn:outgoing>Flow_a_fix_a_submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="a_end" name="Товар опубликован">
      <bpmn:incoming>Flow_a_xor_a_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="a_start2" name="Продавец правит опубликованный товар">
      <bpmn:outgoing>Flow_a_start2_a_edit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_edit" name="Изменить данные товара">
      <bpmn:documentation>FT-3.2: правка названия, описания или типа возвращает товар на модерацию.</bpmn:documentation>
      <bpmn:incoming>Flow_a_start2_a_edit</bpmn:incoming>
      <bpmn:outgoing>Flow_a_edit_a_end2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="a_end2" name="Правка
отправлена">
      <bpmn:incoming>Flow_a_edit_a_end2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_mail" name="Письмо с решением получено">
      <bpmn:documentation>FT-11.4: продавцу приходит письмо о решении модератора с причиной отказа.</bpmn:documentation>
      <bpmn:outgoing>Flow_bs_mail_be_mail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_mail_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="be_mail" name="Продавец уведомлён">
      <bpmn:incoming>Flow_bs_mail_be_mail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a_start_a_create" sourceRef="a_start" targetRef="a_create" />
    <bpmn:sequenceFlow id="Flow_a_create_a_keys" sourceRef="a_create" targetRef="a_keys" />
    <bpmn:sequenceFlow id="Flow_a_keys_a_submit" sourceRef="a_keys" targetRef="a_submit" />
    <bpmn:sequenceFlow id="Flow_a_submit_a_catch" sourceRef="a_submit" targetRef="a_catch" />
    <bpmn:sequenceFlow id="Flow_a_catch_a_xor" sourceRef="a_catch" targetRef="a_xor" />
    <bpmn:sequenceFlow id="Flow_a_xor_a_end" name="опубликован" sourceRef="a_xor" targetRef="a_end" />
    <bpmn:sequenceFlow id="Flow_a_xor_a_fix" name="отклонён" sourceRef="a_xor" targetRef="a_fix" />
    <bpmn:sequenceFlow id="Flow_a_fix_a_submit" sourceRef="a_fix" targetRef="a_submit" />
    <bpmn:sequenceFlow id="Flow_a_start2_a_edit" sourceRef="a_start2" targetRef="a_edit" />
    <bpmn:sequenceFlow id="Flow_a_edit_a_end2" sourceRef="a_edit" targetRef="a_end2" />
    <bpmn:sequenceFlow id="Flow_bs_mail_be_mail" sourceRef="bs_mail" targetRef="be_mail" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_catalog" name="Каталог">
        <bpmn:flowNodeRef>s_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_onmod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_save_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_saved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_moderator" name="Модератор">
        <bpmn:flowNodeRef>u_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_3d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_alert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_stock" name="Остатки и ключи">
        <bpmn:flowNodeRef>s_keys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_keys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_keys</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_notify" name="Уведомления">
        <bpmn:flowNodeRef>t_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_mail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_create" name="Запрос на создание товара">
      <bpmn:outgoing>Flow_s_create_t_draft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_create_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_draft" name="Создать товар, статус «черновик»">
      <bpmn:documentation>SM-04: -&gt; черновик (FT-3.1).</bpmn:documentation>
      <bpmn:incoming>Flow_s_create_t_draft</bpmn:incoming>
      <bpmn:outgoing>Flow_t_draft_e_draft</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_draft" name="Черновик сохранён">
      <bpmn:incoming>Flow_t_draft_e_draft</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_submit" name="Товар отправлен на модерацию">
      <bpmn:outgoing>Flow_s_submit_t_onmod</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_submit_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_onmod" name="Статус «на модерации»">
      <bpmn:documentation>SM-04: черновик (или отклонён) -&gt; на модерации.</bpmn:documentation>
      <bpmn:incoming>Flow_s_submit_t_onmod</bpmn:incoming>
      <bpmn:outgoing>Flow_t_onmod_j1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j1">
      <bpmn:incoming>Flow_t_onmod_j1</bpmn:incoming>
      <bpmn:incoming>Flow_t_back_j1</bpmn:incoming>
      <bpmn:outgoing>Flow_j1_t_queue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_queue" name="Поставить товар в очередь модератора">
      <bpmn:documentation>Срок проверки не более 3 суток (FT-3.2) отсчитывается с момента постановки в очередь.</bpmn:documentation>
      <bpmn:incoming>Flow_j1_t_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_t_queue_u_review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_audit" name="Записать решение в журнал аудита">
      <bpmn:documentation>FT-11.2: действие модератора фиксируется в неизменяемом журнале (NFT-5.3).</bpmn:documentation>
      <bpmn:incoming>Flow_u_review_t_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_audit_g_dec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dec" name="Решение
модератора">
      <bpmn:incoming>Flow_t_audit_g_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_g_dec_t_rej</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_dec_t_pub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rej" name="Статус «отклонён», сохранить причину">
      <bpmn:documentation>SM-04: на модерации -&gt; отклонён. Причина обязательна (FT-3.2).</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_rej</bpmn:incoming>
      <bpmn:outgoing>Flow_t_rej_j2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_pub" name="Статус «опубликован», показать на витрине">
      <bpmn:documentation>SM-04: на модерации -&gt; опубликован. FT-3.1: на витрине только опубликованные товары.</bpmn:documentation>
      <bpmn:incoming>Flow_g_dec_t_pub</bpmn:incoming>
      <bpmn:outgoing>Flow_t_pub_j2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j2">
      <bpmn:incoming>Flow_t_rej_j2</bpmn:incoming>
      <bpmn:incoming>Flow_t_pub_j2</bpmn:incoming>
      <bpmn:outgoing>Flow_j2_t_status</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_status" name="Показать продавцу решение в кабинете">
      <bpmn:documentation>FT-3.2: решение и причина отказа видны в кабинете продавца.</bpmn:documentation>
      <bpmn:incoming>Flow_j2_t_status</bpmn:incoming>
      <bpmn:outgoing>Flow_t_status_t_mail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s_edit" name="Товар изменён продавцом">
      <bpmn:outgoing>Flow_s_edit_g_edit</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_edit_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_edit" name="Изменены название, описание или тип?">
      <bpmn:incoming>Flow_s_edit_g_edit</bpmn:incoming>
      <bpmn:outgoing>Flow_g_edit_t_back</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_edit_t_save_edit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_back" name="Статус «на модерации», снять с витрины">
      <bpmn:documentation>FT-3.2, SM-04: опубликован -&gt; на модерации. Дальше как при обычной отправке.</bpmn:documentation>
      <bpmn:incoming>Flow_g_edit_t_back</bpmn:incoming>
      <bpmn:outgoing>Flow_t_back_j1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_save_edit" name="Сохранить правку, товар остаётся опубликованным">
      <bpmn:documentation>Правка цены, платформы, региона или способа выдачи модерацию не запускает.</bpmn:documentation>
      <bpmn:incoming>Flow_g_edit_t_save_edit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_save_edit_e_saved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_saved" name="Правка применена">
      <bpmn:incoming>Flow_t_save_edit_e_saved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="u_review" name="Проверить товар и принять решение">
      <bpmn:documentation>FT-3.2: одобрить или отклонить с указанием причины. Срок не более 3 суток.</bpmn:documentation>
      <bpmn:incoming>Flow_t_queue_u_review</bpmn:incoming>
      <bpmn:outgoing>Flow_u_review_t_audit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_3d" attachedToRef="u_review" cancelActivity="false">
      <bpmn:outgoing>Flow_b_3d_e_alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="b_3d_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_alert" name="Администратор оповещён о просрочке">
      <bpmn:documentation>NFT-6.1: метрика сроков модерации и оповещение. Товар остаётся в очереди.</bpmn:documentation>
      <bpmn:incoming>Flow_b_3d_e_alert</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_alert_def" />
    </bpmn:endEvent>
    <bpmn:sendTask id="t_mail" name="Отправить продавцу письмо с решением и причиной">
      <bpmn:documentation>FT-11.4: о решении модератора продавец узнаёт и из кабинета, и из письма. Письмо содержит решение и причину отказа.</bpmn:documentation>
      <bpmn:incoming>Flow_t_status_t_mail</bpmn:incoming>
      <bpmn:outgoing>Flow_t_mail_e_mail</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e_mail" name="Продавец уведомлён">
      <bpmn:incoming>Flow_t_mail_e_mail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_keys" name="Пул ключей получен">
      <bpmn:outgoing>Flow_s_keys_t_keys</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_keys_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_keys" name="Отклонить дубликаты, зашифровать и сохранить ключи">
      <bpmn:documentation>FT-4.1, FT-4.2, NFT-3.2: дубликаты проверяются по HMAC в пределах товара, ключи шифруются AES-256.</bpmn:documentation>
      <bpmn:incoming>Flow_s_keys_t_keys</bpmn:incoming>
      <bpmn:outgoing>Flow_t_keys_e_keys</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_keys" name="Ключи в пуле: «свободны»">
      <bpmn:documentation>SM-03: свободен. FT-4.3: остаток растёт.</bpmn:documentation>
      <bpmn:incoming>Flow_t_keys_e_keys</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_create_t_draft" sourceRef="s_create" targetRef="t_draft" />
    <bpmn:sequenceFlow id="Flow_t_draft_e_draft" sourceRef="t_draft" targetRef="e_draft" />
    <bpmn:sequenceFlow id="Flow_s_submit_t_onmod" sourceRef="s_submit" targetRef="t_onmod" />
    <bpmn:sequenceFlow id="Flow_t_onmod_j1" sourceRef="t_onmod" targetRef="j1" />
    <bpmn:sequenceFlow id="Flow_j1_t_queue" sourceRef="j1" targetRef="t_queue" />
    <bpmn:sequenceFlow id="Flow_t_queue_u_review" sourceRef="t_queue" targetRef="u_review" />
    <bpmn:sequenceFlow id="Flow_u_review_t_audit" sourceRef="u_review" targetRef="t_audit" />
    <bpmn:sequenceFlow id="Flow_t_audit_g_dec" sourceRef="t_audit" targetRef="g_dec" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_rej" name="отклонить с причиной" sourceRef="g_dec" targetRef="t_rej" />
    <bpmn:sequenceFlow id="Flow_g_dec_t_pub" name="одобрить" sourceRef="g_dec" targetRef="t_pub" />
    <bpmn:sequenceFlow id="Flow_t_rej_j2" sourceRef="t_rej" targetRef="j2" />
    <bpmn:sequenceFlow id="Flow_t_pub_j2" sourceRef="t_pub" targetRef="j2" />
    <bpmn:sequenceFlow id="Flow_j2_t_status" sourceRef="j2" targetRef="t_status" />
    <bpmn:sequenceFlow id="Flow_t_status_t_mail" sourceRef="t_status" targetRef="t_mail" />
    <bpmn:sequenceFlow id="Flow_t_mail_e_mail" sourceRef="t_mail" targetRef="e_mail" />
    <bpmn:sequenceFlow id="Flow_s_edit_g_edit" sourceRef="s_edit" targetRef="g_edit" />
    <bpmn:sequenceFlow id="Flow_g_edit_t_back" name="да" sourceRef="g_edit" targetRef="t_back" />
    <bpmn:sequenceFlow id="Flow_g_edit_t_save_edit" name="нет" sourceRef="g_edit" targetRef="t_save_edit" />
    <bpmn:sequenceFlow id="Flow_t_save_edit_e_saved" sourceRef="t_save_edit" targetRef="e_saved" />
    <bpmn:sequenceFlow id="Flow_t_back_j1" sourceRef="t_back" targetRef="j1" />
    <bpmn:sequenceFlow id="Flow_b_3d_e_alert" sourceRef="b_3d" targetRef="e_alert" />
    <bpmn:sequenceFlow id="Flow_s_keys_t_keys" sourceRef="s_keys" targetRef="t_keys" />
    <bpmn:sequenceFlow id="Flow_t_keys_e_keys" sourceRef="t_keys" targetRef="e_keys" />
    <bpmn:textAnnotation id="Note_stock"><bpmn:text>Товар с нулевым остатком виден на витрине, но заказать его нельзя (FT-4.4). Проверка остатка выполняется при оформлении заказа (BPMN-01)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_stock" sourceRef="Note_stock" targetRef="t_pub" />
    <bpmn:textAnnotation id="Note_3d"><bpmn:text>Срок проверки товара не более 3 суток (FT-3.2). При просрочке администратор получает оповещение, товар остаётся в очереди (NFT-6.1)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_3d" sourceRef="Note_3d" targetRef="e_alert" />
  </bpmn:process>
