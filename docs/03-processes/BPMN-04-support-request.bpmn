<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_buyer" name="Покупатель" processRef="Process_buyer" />
    <bpmn:participant id="P_platform" name="Платформа" processRef="Process_platform" />
    <bpmn:participant id="P_mail" name="E-mail-провайдер" />
    <bpmn:participant id="P_sms" name="SMS-провайдер" />
    <bpmn:messageFlow id="Msg_b_open_s_ticket" name="Обращение по заказу" sourceRef="b_open" targetRef="s_ticket" />
    <bpmn:messageFlow id="Msg_b_code_sms_sp_sms" name="Код из SMS" sourceRef="b_code_sms" targetRef="sp_sms" />
    <bpmn:messageFlow id="Msg_b_code_mail_sp_mail" name="Код из письма" sourceRef="b_code_mail" targetRef="sp_mail" />
    <bpmn:messageFlow id="Msg_sp_sms_P_sms" name="Код на телефон" sourceRef="sp_sms" targetRef="P_sms" />
    <bpmn:messageFlow id="Msg_P_sms_bs_sms" name="SMS с кодом" sourceRef="P_sms" targetRef="bs_sms" />
    <bpmn:messageFlow id="Msg_sp_mail_P_mail" name="Код на e-mail" sourceRef="sp_mail" targetRef="P_mail" />
    <bpmn:messageFlow id="Msg_P_mail_bs_mail" name="Письмо с кодом" sourceRef="P_mail" targetRef="bs_mail" />
    <bpmn:messageFlow id="Msg_t_resend_P_mail" name="Повторное письмо" sourceRef="t_resend" targetRef="P_mail" />
    <bpmn:messageFlow id="Msg_P_mail_im_ok" name="Доставка подтверждена" sourceRef="P_mail" targetRef="im_ok" />
    <bpmn:messageFlow id="Msg_P_mail_im_nd" name="Недоставка" sourceRef="P_mail" targetRef="im_nd" />
    <bpmn:messageFlow id="Msg_P_mail_bs_key" name="Письмо с ключом" sourceRef="P_mail" targetRef="bs_key" />
  </bpmn:collaboration>
  <bpmn:process id="Process_buyer" isExecutable="false">
    <bpmn:startEvent id="b_start" name="Покупатель не получил ключ">
      <bpmn:outgoing>Flow_b_start_g_access</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_access" name="Есть доступ к кабинету?">
      <bpmn:incoming>Flow_b_start_g_access</bpmn:incoming>
      <bpmn:outgoing>Flow_g_access_m_acc</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_access_sp_login</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_login" name="Войти по коду из SMS">
      <bpmn:documentation>Решение по вопросу 1 из приложения C: вход по одноразовому коду из SMS на подтверждённый телефон. NFT-3.7: код 5 минут, 5 попыток. NFT-3.5: ограничение частоты запросов. Детали в Ф2 (ADR-010).</bpmn:documentation>
      <bpmn:incoming>Flow_g_access_sp_login</bpmn:incoming>
      <bpmn:outgoing>Flow_sp_login_m_acc</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="be_login" attachedToRef="sp_login">
      <bpmn:outgoing>Flow_be_login_e_login_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_login_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_login_fail" name="Вход не выполнен">
      <bpmn:incoming>Flow_be_login_e_login_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="m_acc">
      <bpmn:incoming>Flow_g_access_m_acc</bpmn:incoming>
      <bpmn:incoming>Flow_sp_login_m_acc</bpmn:incoming>
      <bpmn:outgoing>Flow_m_acc_b_open</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="b_open" name="Открыть заказ и нажать «Не получил ключ»">
      <bpmn:documentation>FT-7.2: в течение 72 часов после выдачи. Кнопка есть в карточке заказа со статусом «выдан».</bpmn:documentation>
      <bpmn:incoming>Flow_m_acc_b_open</bpmn:incoming>
      <bpmn:outgoing>Flow_b_open_e_open</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_open" name="Обращение отправлено">
      <bpmn:incoming>Flow_b_open_e_open</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_sms" name="SMS с кодом получено">
      <bpmn:outgoing>Flow_bs_sms_b_code_sms</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_sms_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="b_code_sms" name="Ввести код из SMS в форме обращения">
      <bpmn:documentation>FT-7.5: код вводит сам покупатель. Оператор код не видит и не принимает.</bpmn:documentation>
      <bpmn:incoming>Flow_bs_sms_b_code_sms</bpmn:incoming>
      <bpmn:outgoing>Flow_b_code_sms_ee_sms</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ee_sms" name="Код отправлен на проверку">
      <bpmn:incoming>Flow_b_code_sms_ee_sms</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_mail" name="Письмо с кодом получено">
      <bpmn:outgoing>Flow_bs_mail_b_code_mail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_mail_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="b_code_mail" name="Ввести код из письма в форме обращения">
      <bpmn:documentation>Решение по вопросу 2 из приложения C: новый e-mail подтверждается кодом, который покупатель получает на этот адрес.</bpmn:documentation>
      <bpmn:incoming>Flow_bs_mail_b_code_mail</bpmn:incoming>
      <bpmn:outgoing>Flow_b_code_mail_ee_mail</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ee_mail" name="Код отправлен на проверку">
      <bpmn:incoming>Flow_b_code_mail_ee_mail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="bs_key" name="Письмо с ключом получено">
      <bpmn:outgoing>Flow_bs_key_be_key</bpmn:outgoing>
      <bpmn:messageEventDefinition id="bs_key_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="be_key" name="Покупатель получил ключ">
      <bpmn:incoming>Flow_bs_key_be_key</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_b_start_g_access" sourceRef="b_start" targetRef="g_access" />
    <bpmn:sequenceFlow id="Flow_g_access_m_acc" name="да" sourceRef="g_access" targetRef="m_acc" />
    <bpmn:sequenceFlow id="Flow_g_access_sp_login" name="нет" sourceRef="g_access" targetRef="sp_login" />
    <bpmn:sequenceFlow id="Flow_sp_login_m_acc" sourceRef="sp_login" targetRef="m_acc" />
    <bpmn:sequenceFlow id="Flow_be_login_e_login_fail" sourceRef="be_login" targetRef="e_login_fail" />
    <bpmn:sequenceFlow id="Flow_m_acc_b_open" sourceRef="m_acc" targetRef="b_open" />
    <bpmn:sequenceFlow id="Flow_b_open_e_open" sourceRef="b_open" targetRef="e_open" />
    <bpmn:sequenceFlow id="Flow_bs_sms_b_code_sms" sourceRef="bs_sms" targetRef="b_code_sms" />
    <bpmn:sequenceFlow id="Flow_b_code_sms_ee_sms" sourceRef="b_code_sms" targetRef="ee_sms" />
    <bpmn:sequenceFlow id="Flow_bs_mail_b_code_mail" sourceRef="bs_mail" targetRef="b_code_mail" />
    <bpmn:sequenceFlow id="Flow_b_code_mail_ee_mail" sourceRef="b_code_mail" targetRef="ee_mail" />
    <bpmn:sequenceFlow id="Flow_bs_key_be_key" sourceRef="bs_key" targetRef="be_key" />
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_platform">
      <bpmn:lane id="Lane_support" name="Поддержка">
        <bpmn:flowNodeRef>s_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_win</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_operator" name="Оператор поддержки">
        <bpmn:flowNodeRef>u_handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_email</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_notify" name="Уведомления">
        <bpmn:flowNodeRef>sp_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_identity" name="Идентификация">
        <bpmn:flowNodeRef>t_chg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_delivery" name="Выдача">
        <bpmn:flowNodeRef>t_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>im_nd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_ticket" name="Обращение от покупателя">
      <bpmn:outgoing>Flow_s_ticket_g_win</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_ticket_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_win" name="Не больше 72 часов после выдачи?">
      <bpmn:incoming>Flow_s_ticket_g_win</bpmn:incoming>
      <bpmn:outgoing>Flow_g_win_t_create</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_win_t_deny</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_deny" name="Отклонить обращение: срок истёк">
      <bpmn:documentation>FT-7.2: окно 72 часа после первичного перехода заказа в «выдан». Повторная отправка этот срок не сдвигает.</bpmn:documentation>
      <bpmn:incoming>Flow_g_win_t_deny</bpmn:incoming>
      <bpmn:outgoing>Flow_t_deny_e_deny</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_deny" name="Обращение отклонено">
      <bpmn:incoming>Flow_t_deny_e_deny</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_auto" name="Заказ передан системой (BPMN-01)">
      <bpmn:documentation>FT-7.3, NFT-2.4: недоставка, исчерпание попыток или 30 минут без доставки. Окно 72 часа здесь не применяется.</bpmn:documentation>
      <bpmn:outgoing>Flow_s_auto_t_create</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_auto_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_create" name="Создать обращение «создано», поставить в очередь">
      <bpmn:documentation>SM-07: -&gt; создано. В очередь попадают обращения покупателей и заказы, переданные системой.</bpmn:documentation>
      <bpmn:incoming>Flow_g_win_t_create</bpmn:incoming>
      <bpmn:incoming>Flow_s_auto_t_create</bpmn:incoming>
      <bpmn:outgoing>Flow_t_create_u_handle</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_audit" name="Записать решение оператора в журнал аудита">
      <bpmn:documentation>FT-11.2, NFT-5.3: журнал хранит ID, действие и объект. Персональные данные в открытом виде не попадают.</bpmn:documentation>
      <bpmn:incoming>Flow_u_handle_t_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_t_audit_g_act</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_resolve" name="Обращение «решено»">
      <bpmn:documentation>SM-07: в работе -&gt; решено.</bpmn:documentation>
      <bpmn:incoming>Flow_t_done_t_resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_t_resolve_e_resolved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_resolved" name="Обращение решено">
      <bpmn:incoming>Flow_t_resolve_e_resolved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="u_handle" name="Взять в работу и разобрать обращение">
      <bpmn:documentation>SM-07: создано -&gt; в работе. Ключ оператору не показывается (FT-7.5).</bpmn:documentation>
      <bpmn:incoming>Flow_t_create_u_handle</bpmn:incoming>
      <bpmn:outgoing>Flow_u_handle_t_audit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_act" name="Какое действие?">
      <bpmn:incoming>Flow_t_audit_g_act</bpmn:incoming>
      <bpmn:outgoing>Flow_g_act_u_email</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_act_t_resend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_email" name="Ввести новый e-mail покупателя">
      <bpmn:documentation>FT-7.5: оператор меняет e-mail учётной записи только после проверки кода. Код вводит покупатель.</bpmn:documentation>
      <bpmn:incoming>Flow_g_act_u_email</bpmn:incoming>
      <bpmn:outgoing>Flow_u_email_sp_sms</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="sp_sms" name="Проверить код из SMS на привязанный телефон">
      <bpmn:documentation>FT-7.5, FT-1.5, NFT-3.7: код уходит на телефон из учётной записи, действует 5 минут, 5 попыток. Покупатель вводит код сам, оператор получает только результат проверки.</bpmn:documentation>
      <bpmn:incoming>Flow_u_email_sp_sms</bpmn:incoming>
      <bpmn:outgoing>Flow_sp_sms_sp_mail</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="be_sms" attachedToRef="sp_sms">
      <bpmn:outgoing>Flow_be_sms_e_f1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_sms_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_f1" name="Проверка телефона не пройдена">
      <bpmn:documentation>Обращение остаётся «в работе». Оператор видит только результат проверки.</bpmn:documentation>
      <bpmn:incoming>Flow_be_sms_e_f1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="sp_mail" name="Проверить код из письма на новый e-mail">
      <bpmn:documentation>Решение по вопросу 2 из приложения C: код уходит на новый адрес, действует 5 минут, 5 попыток.</bpmn:documentation>
      <bpmn:incoming>Flow_sp_sms_sp_mail</bpmn:incoming>
      <bpmn:outgoing>Flow_sp_mail_t_chg</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="be_mail" attachedToRef="sp_mail">
      <bpmn:outgoing>Flow_be_mail_e_f2</bpmn:outgoing>
      <bpmn:errorEventDefinition id="be_mail_def" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_f2" name="Новый e-mail не подтверждён">
      <bpmn:documentation>Обращение остаётся «в работе». Адрес в учётной записи не меняется.</bpmn:documentation>
      <bpmn:incoming>Flow_be_mail_e_f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_chg" name="Сменить e-mail учётной записи">
      <bpmn:documentation>FT-7.5: изменение e-mail в Keycloak. В журнал аудита: имя поля и HMAC-хеши значений до и после (NFT-5.3).</bpmn:documentation>
      <bpmn:incoming>Flow_sp_mail_t_chg</bpmn:incoming>
      <bpmn:outgoing>Flow_t_chg_t_resend</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_resend" name="Обновить снимок адреса и отправить письмо повторно">
      <bpmn:documentation>FT-7.5: снимок адреса доставки в заказе обновляется. SM-06: новая выдача типа «повторная». Окна поддержки, спора и удержания не сдвигаются.</bpmn:documentation>
      <bpmn:incoming>Flow_g_act_t_resend</bpmn:incoming>
      <bpmn:incoming>Flow_t_chg_t_resend</bpmn:incoming>
      <bpmn:outgoing>Flow_t_resend_eg_del</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="eg_del">
      <bpmn:incoming>Flow_t_resend_eg_del</bpmn:incoming>
      <bpmn:outgoing>Flow_eg_del_im_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_eg_del_im_nd</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="im_ok" name="Провайдер подтвердил доставку">
      <bpmn:incoming>Flow_eg_del_im_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_im_ok_t_done</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_ok_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_done" name="Выдача «доставлено»">
      <bpmn:documentation>SM-06: отправлено -&gt; доставлено.</bpmn:documentation>
      <bpmn:incoming>Flow_im_ok_t_done</bpmn:incoming>
      <bpmn:outgoing>Flow_t_done_t_resolve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="im_nd" name="Провайдер сообщил о недоставке">
      <bpmn:incoming>Flow_eg_del_im_nd</bpmn:incoming>
      <bpmn:outgoing>Flow_im_nd_e_nd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="im_nd_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_nd" name="Выдача «ошибка»: обращение остаётся в работе">
      <bpmn:documentation>SM-06: -&gt; ошибка. Оператор может повторить действие.</bpmn:documentation>
      <bpmn:incoming>Flow_im_nd_e_nd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_ticket_g_win" sourceRef="s_ticket" targetRef="g_win" />
    <bpmn:sequenceFlow id="Flow_g_win_t_create" name="да" sourceRef="g_win" targetRef="t_create" />
    <bpmn:sequenceFlow id="Flow_g_win_t_deny" name="нет" sourceRef="g_win" targetRef="t_deny" />
    <bpmn:sequenceFlow id="Flow_t_deny_e_deny" sourceRef="t_deny" targetRef="e_deny" />
    <bpmn:sequenceFlow id="Flow_s_auto_t_create" sourceRef="s_auto" targetRef="t_create" />
    <bpmn:sequenceFlow id="Flow_t_create_u_handle" sourceRef="t_create" targetRef="u_handle" />
    <bpmn:sequenceFlow id="Flow_u_handle_t_audit" sourceRef="u_handle" targetRef="t_audit" />
    <bpmn:sequenceFlow id="Flow_t_audit_g_act" sourceRef="t_audit" targetRef="g_act" />
    <bpmn:sequenceFlow id="Flow_g_act_u_email" name="смена e-mail" sourceRef="g_act" targetRef="u_email" />
    <bpmn:sequenceFlow id="Flow_g_act_t_resend" name="повторная отправка" sourceRef="g_act" targetRef="t_resend" />
    <bpmn:sequenceFlow id="Flow_u_email_sp_sms" sourceRef="u_email" targetRef="sp_sms" />
    <bpmn:sequenceFlow id="Flow_sp_sms_sp_mail" sourceRef="sp_sms" targetRef="sp_mail" />
    <bpmn:sequenceFlow id="Flow_be_sms_e_f1" sourceRef="be_sms" targetRef="e_f1" />
    <bpmn:sequenceFlow id="Flow_be_mail_e_f2" sourceRef="be_mail" targetRef="e_f2" />
    <bpmn:sequenceFlow id="Flow_sp_mail_t_chg" sourceRef="sp_mail" targetRef="t_chg" />
    <bpmn:sequenceFlow id="Flow_t_chg_t_resend" sourceRef="t_chg" targetRef="t_resend" />
