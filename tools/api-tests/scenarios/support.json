{
  "id": "SUP-01",
  "title": "Очередь оператора: права, проверка параметров, неизвестный номер заказа и неизвестное обращение (TC-704, TC-705, TC-706, TC-707; ST-02, ST-13)",
  "steps": [
    {"name": "TC-704. Очередь без токена: 401 unauthenticated", "op": "listSupportTicketQueue", "as": "guest", "expect": 401,
     "assert": [{"path": "code", "equals": "unauthenticated"}, {"header": "Content-Type", "contains": "application/problem+json"}]},
    {"name": "TC-704. Очередь покупателю: 403 forbidden", "op": "listSupportTicketQueue", "as": "buyer", "expect": 403,
     "assert": [{"path": "code", "equals": "forbidden"}, {"header": "Content-Type", "contains": "application/problem+json"}]},
    {"name": "TC-704. Очередь модератору: 403 forbidden", "op": "listSupportTicketQueue", "as": "moderator", "expect": 403,
     "assert": [{"header": "Content-Type", "contains": "application/problem+json"}]},
    {"name": "TC-704. Очередь оператору: 200, страница по схеме, ответ не кэшируется", "op": "listSupportTicketQueue", "as": "support-operator",
     "query": {"limit": "5"}, "expect": 200,
     "assert": [{"path": "items", "exists": true}, {"path": "page.limit", "equals": 5}, {"header": "Cache-Control", "contains": "no-store"}]},
    {"name": "TC-704. Очередь: неизвестный статус и номер заказа не число: 422 validation-failed", "op": "listSupportTicketQueue", "as": "support-operator",
     "query": {"status": "open", "operatorId": "x"}, "expect": 422,
     "assert": [{"path": "code", "equals": "validation-failed"}, {"path": "errors", "notEmpty": true}]},
    {"name": "TC-707. Поиск по несуществующему номеру заказа: 200 и пустая страница без подсказок", "op": "listSupportTicketQueue", "as": "support-operator",
     "query": {"orderNumber": "999999999"}, "expect": 200,
     "assert": [{"path": "items", "equals": []}, {"path": "page.nextCursor", "equals": null}]},
    {"name": "TC-707. Поиск по номеру заказа покупателем: 403 forbidden", "op": "listSupportTicketQueue", "as": "buyer",
     "query": {"orderNumber": "1001"}, "expect": 403},
    {"name": "TC-704. Карточка неизвестного обращения: 404 not-found", "op": "getStaffSupportTicket", "as": "support-operator",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 404,
     "assert": [{"path": "code", "equals": "not-found"}]},
    {"name": "TC-704. Карточка покупателю: 403 forbidden", "op": "getStaffSupportTicket", "as": "buyer",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 403},
    {"name": "TC-705. Взять неизвестное обращение: 404 not-found", "op": "takeSupportTicket", "as": "support-operator",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 404,
     "assert": [{"path": "code", "equals": "not-found"}]},
    {"name": "TC-705. Взять обращение покупателю: 403 forbidden", "op": "takeSupportTicket", "as": "buyer",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 403},
    {"name": "TC-706. Вернуть в очередь неизвестное обращение: 404 not-found", "op": "releaseSupportTicket", "as": "support-operator",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 404,
     "assert": [{"path": "code", "equals": "not-found"}]},
    {"name": "TC-706. Вернуть в очередь администратору: 403 forbidden", "op": "releaseSupportTicket", "as": "admin",
     "path": {"ticketId": "00000000-0000-4000-8000-000000000000"}, "expect": 403}
  ]
}
