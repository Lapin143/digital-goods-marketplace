# Образец настроек Compose. Скопируйте в .env (файл в .gitignore), если нужно изменить значения по умолчанию.

# Каталог секретов и сертификатов (создаётся командами make certs secrets)
DGM_SECRETS_DIR=./secrets

# Перезапуск контейнеров: на ноутбуке no, на сервере unless-stopped
DGM_RESTART=no

# Метка образов сервисов, собранных make docker-images
IMAGE_TAG=dev

# Мастер-ключ ключей товаров (ADR-009): эти две строки ведёт tools/ops/kek_rotate.py, вручную их менять не нужно
# DGM_KEK_VERSION=1
# DGM_KEK_ROTATE=false
