      }
    },
    {
      "id": 4,
      "title": "Отказов 403 за час",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(dgm_gateway_rejected_total{reason=\"forbidden\"}[1h]))",
          "instant": true,
          "refId": "A",
