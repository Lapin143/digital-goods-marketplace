{
  "_comment": "Перечень сертификатов и секретов стенда (containers: контейнеры с сертификатом, jobs: разовые задания без сертификата, читающие секреты). Источник: docs/05-architecture/c4-deployment.md (раздел 6) и ADR-022. check_compose.py сверяет с ним монтирование секретов в compose.yaml.",
  "ca": {
    "common_name": "DGM Private CA",
    "organization": "digital-goods-marketplace",
    "years": 5
  },
  "cert_days": 90,
  "renew_before_days": 30,
  "containers": [
    {"name": "web-app"},
    {"name": "api-gateway"},
    {"name": "keycloak"},
    {"name": "catalog-service"},
    {"name": "inventory-service"},
    {"name": "order-service"},
    {"name": "payment-service"},
    {"name": "delivery-service"},
    {"name": "platform-service"},
    {"name": "object-storage"},
    {"name": "postgres"},
    {"name": "kafka"},
    {"name": "kafka-init"},
    {"name": "redis"},
    {"name": "external-stubs"},
    {"name": "prometheus"}
  ],
  "jobs": [
    {"name": "storage-init", "purpose": "Разовое задание: входит в хранилище по паролю из секрета, своего сертификата не имеет, читает секреты как контейнер из списка выше"}
  ],
  "secrets": [
    {"name": "inventory_kek", "kind": "key32", "readers": ["inventory-service"], "purpose": "Мастер-ключ шифрования ключей AES-256 (ADR-009)"},
    {"name": "inventory_hmac", "kind": "key32", "readers": ["inventory-service"], "purpose": "HMAC для проверки дублей ключей (ADR-009)"},
    {"name": "payment_gateway_key", "kind": "password", "readers": ["payment-service", "external-stubs"], "purpose": "Доступ к платёжному шлюзу"},
    {"name": "payment_webhook_secret", "kind": "key32", "readers": ["payment-service", "external-stubs"], "purpose": "Подпись вебхуков платёжного шлюза (ADR-015)"},
    {"name": "delivery_email_key", "kind": "password", "readers": ["delivery-service", "external-stubs"], "purpose": "Отправка писем с ключом"},
    {"name": "delivery_webhook_secret", "kind": "key32", "readers": ["delivery-service", "external-stubs"], "purpose": "Подпись статусов письма"},
    {"name": "platform_email_key", "kind": "password", "readers": ["platform-service", "external-stubs"], "purpose": "Отправка писем платформы"},
    {"name": "platform_sms_key", "kind": "password", "readers": ["platform-service", "external-stubs"], "purpose": "Отправка SMS"},
    {"name": "platform_webhook_secret", "kind": "key32", "readers": ["platform-service", "external-stubs"], "purpose": "Подпись статусов писем и SMS"},
    {"name": "platform_audit_hmac", "kind": "key32", "readers": ["platform-service"], "purpose": "Хеши персональных полей в журнале аудита (ADR-014)"},
    {"name": "platform_otp_pepper", "kind": "key32", "readers": ["platform-service"], "purpose": "HMAC кодов подтверждения в Redis (ADR-010)"},

    {"name": "db_postgres_admin", "kind": "password", "readers": ["postgres"], "purpose": "Администратор PostgreSQL, только инициализация баз и ролей"},
    {"name": "db_migrator_catalog", "kind": "password", "readers": ["catalog-service", "postgres"], "purpose": "Роль миграций Flyway базы catalog_db"},
    {"name": "db_migrator_inventory", "kind": "password", "readers": ["inventory-service", "postgres"], "purpose": "Роль миграций Flyway базы inventory_db"},
    {"name": "db_migrator_order", "kind": "password", "readers": ["order-service", "postgres"], "purpose": "Роль миграций Flyway базы order_db"},
    {"name": "db_migrator_payment", "kind": "password", "readers": ["payment-service", "postgres"], "purpose": "Роль миграций Flyway базы payment_db"},
    {"name": "db_migrator_delivery", "kind": "password", "readers": ["delivery-service", "postgres"], "purpose": "Роль миграций Flyway базы delivery_db"},
    {"name": "db_migrator_platform", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Роль миграций Flyway базы platform_db"},
    {"name": "db_app_seller_onboarding", "kind": "password", "readers": ["catalog-service", "postgres"], "purpose": "Рабочая роль модуля seller_onboarding"},
    {"name": "db_app_catalog", "kind": "password", "readers": ["catalog-service", "postgres"], "purpose": "Рабочая роль модуля catalog"},
    {"name": "db_app_inventory", "kind": "password", "readers": ["inventory-service", "postgres"], "purpose": "Рабочая роль модуля inventory"},
    {"name": "db_app_orders", "kind": "password", "readers": ["order-service", "postgres"], "purpose": "Рабочая роль модуля orders"},
    {"name": "db_app_payments", "kind": "password", "readers": ["payment-service", "postgres"], "purpose": "Рабочая роль модуля payments"},
    {"name": "db_app_delivery", "kind": "password", "readers": ["delivery-service", "postgres"], "purpose": "Рабочая роль модуля delivery"},
    {"name": "db_app_identity", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Рабочая роль модуля identity"},
    {"name": "db_app_support", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Рабочая роль модуля support"},
    {"name": "db_app_notification", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Рабочая роль модуля notification"},
    {"name": "db_app_audit_admin", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Рабочая роль модуля audit_admin"},
    {"name": "db_app_audit_writer", "kind": "password", "readers": ["platform-service", "postgres"], "purpose": "Роль записи аудита, только INSERT (INV-43)"},
    {"name": "db_keycloak", "kind": "password", "readers": ["keycloak", "postgres"], "purpose": "Роль базы Keycloak"},

    {"name": "redis_admin", "kind": "password", "readers": ["redis"], "purpose": "Служебный пользователь Redis (проверка готовности, администрирование)"},
    {"name": "redis_catalog", "kind": "password", "readers": ["catalog-service", "redis"], "purpose": "Пользователь Redis сервиса каталога"},
    {"name": "redis_inventory", "kind": "password", "readers": ["inventory-service", "redis"], "purpose": "Пользователь Redis сервиса остатков"},
    {"name": "redis_platform", "kind": "password", "readers": ["platform-service", "redis"], "purpose": "Пользователь Redis служебного сервиса"},
    {"name": "redis_gateway", "kind": "password", "readers": ["api-gateway", "redis"], "purpose": "Пользователь Redis шлюза (ограничение частоты)"},

    {"name": "storage_admin", "kind": "password", "readers": ["object-storage", "storage-init"], "purpose": "Корневая запись объектного хранилища (имя в infra/storage/root_user), только запуск и инициализация (ADR-024)"},
    {"name": "storage_catalog", "kind": "password", "readers": ["catalog-service", "storage-init"], "purpose": "Учётная запись catalog-service только на бакет seller-documents (ADR-024)"},

    {"name": "keycloak_admin", "kind": "password", "readers": ["keycloak"], "purpose": "Начальный администратор Keycloak"},
    {"name": "keycloak_client_platform", "kind": "password", "readers": ["keycloak", "platform-service"], "purpose": "Секрет клиента platform-service для Admin API Keycloak (назначение ролей по событиям)"}
  ]
}
