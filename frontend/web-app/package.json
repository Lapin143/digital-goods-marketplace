{
  "name": "dgm-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб-интерфейс маркетплейса цифровых товаров: витрина, кабинет продавца, рабочее место модератора",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "node scripts/gen-api.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "size": "node scripts/check-size.mjs",
    "check": "npm run gen:api && npm run lint && npm run typecheck && npm test && npm run build && npm run size"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
